#!/usr/bin/env bash
# mivia pre-commit: control surface, secrets, docs, gofmt, contracts, optional semgrep.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if [[ -d "${HOME:-}/.local/bin" ]]; then
  PATH="${HOME}/.local/bin:${PATH}"
  export PATH
fi
SUMMARY_FILE="$(git rev-parse --git-path mivia-precommit-summary)"
rm -f "$SUMMARY_FILE"

fail() {
  printf 'pre-commit: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command '$1'"
}

require_cmd python3

python3 scripts/verify_agent_config.py
python3 scripts/secret_scan.py --staged
python3 scripts/git-hooks/file-size-check
python3 scripts/check_go_structure.py --staged

mapfile -d '' STAGED_DOCS < <(
  git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '^docs/' | tr '\n' '\0' || true
)
if ((${#STAGED_DOCS[@]})); then
  python3 scripts/check_docs_ownership.py --staged
fi

GOFMT_SUMMARY="gofmt skipped"
mapfile -d '' GO_FILES < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.go')
if ((${#GO_FILES[@]})); then
  require_cmd gofmt
  gofmt -w "${GO_FILES[@]}"
  git add -- "${GO_FILES[@]}"
  GOFMT_SUMMARY="gofmt ${#GO_FILES[@]} file(s)"
fi

git diff --check --cached

SEMGREP_SUMMARY="semgrep skipped (not installed)"
if command -v semgrep >/dev/null 2>&1; then
  if [[ -f semgrep/agent-standards.yml ]]; then
    semgrep --validate --config semgrep/agent-standards.yml >/dev/null
    mapfile -d '' STAGED_FILES < <(
      git diff --cached --name-only --diff-filter=ACMR -z -- ':!semgrep/agent-standards.yml'
    )
    if ((${#STAGED_FILES[@]})); then
      semgrep --config semgrep/agent-standards.yml \
        --error --skip-unknown-extensions --metrics off --disable-nosem \
        "${STAGED_FILES[@]}"
      SEMGREP_SUMMARY="staged semgrep 0 findings"
    else
      SEMGREP_SUMMARY="semgrep validated (no staged scan targets)"
    fi
  else
    SEMGREP_SUMMARY="semgrep skipped (no config)"
  fi
else
  printf 'pre-commit: semgrep not installed; staged scan skipped (pre-push requires it when config exists)\n' >&2
fi

TREE="$(git write-tree)"
printf 'tree=%s\nsummary=%s\n' \
  "$TREE" \
  "Quality: pre-commit passed (agent config, secret scan, docs when staged, whitespace, contract tests, ${SEMGREP_SUMMARY}; ${GOFMT_SUMMARY})" \
  >"$SUMMARY_FILE"
