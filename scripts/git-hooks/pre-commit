#!/usr/bin/env bash
# mivia pre-commit: fast deterministic checks first, then independent static gates.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if [[ -d "${HOME:-}/.local/bin" ]]; then
  PATH="${HOME}/.local/bin:${PATH}"
  export PATH
fi

# --no-invariants bypass: logs to .git/invariant-bypass-log and skips
for arg in "$@"; do
  if [ "$arg" = "--no-invariants" ]; then
    BYPASS_LOG="$(git rev-parse --git-dir)/invariant-bypass-log"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) BYPASS ${USER:-unknown} $(git rev-parse HEAD)" >> "$BYPASS_LOG"
    printf 'pre-commit: ⚠ Invariant bypass logged to %s\n' "$BYPASS_LOG" >&2
    exit 0
  fi
done

SUMMARY_FILE="$(git rev-parse --git-path mivia-precommit-summary)"
rm -f "$SUMMARY_FILE"

fail() {
  printf 'pre-commit: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command '$1'"
}

require_cmd python3
run_verify() { "$ROOT/scripts/git-hooks/run_without_git_env" "$@"; }

# These checks are cheap and mutate the index (gofmt), so run them before scans.
git diff --check --cached
mapfile -d '' GO_FILES < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.go')
if ((${#GO_FILES[@]})); then
  require_cmd gofmt
  # Fully staged files keep the auto-format + re-add path. Partially staged
  # files (unstaged hunks present) must NEVER be re-added: `git add -- file`
  # stages the whole working-tree file and silently overstages unstaged hunks.
  # For those, format only the staged blob (git show :file | gofmt) into a new
  # blob (git hash-object -w) and rewrite only the index entry with the real
  # mode from `git ls-files -s` (first field, never hardcoded), skipping the
  # update when the formatted hash equals the current staged hash. The
  # working-tree file is never touched, so unstaged hunks stay unstaged while
  # the committed tree stays gofmt-clean.
  for file in "${GO_FILES[@]}"; do
    if git diff --quiet -- "$file"; then
      gofmt -w "$file"
      git add -- "$file"
    else
      mode="$(git ls-files -s -- "$file" | awk '{print $1}')"
      current="$(git rev-parse :"$file")"
      formatted="$(git show :"$file" | gofmt | git hash-object -w --stdin)"
      if [ "$formatted" != "$current" ]; then
        git update-index --cacheinfo "$mode" "$formatted" "$file"
      fi
    fi
  done
  git diff --check --cached
  GOFMT_SUMMARY="gofmt ${#GO_FILES[@]} file(s)"
else
  GOFMT_SUMMARY="gofmt skipped"
fi

# Auto-stage a modified .mivia/memory.db that the caller forgot to `git add`,
# so every commit picks up the latest memory store instead of silently
# leaving it behind. Only a working-tree modification to a tracked file is
# staged here - never an untracked/new file, and never a deletion - so this
# cannot turn an unrelated commit into one that adds or removes the db.
if git diff --name-only --diff-filter=M -- .mivia/memory.db | grep -qx '\.mivia/memory\.db'; then
  git add -- .mivia/memory.db
fi

# Materialize the STAGED tree into a real directory and run every gate that
# reads file content (as opposed to just a staged file LIST) against that
# copy, not the live working tree. Several gates below (structure, size,
# docs-ownership) read file bytes straight off disk by path even in their
# "staged" mode - only the path LIST came from the index, the content came
# from the working tree. A file with staged changes plus additional UNSTAGED
# edits on top would silently be checked against content that was never
# staged and will not be in the commit. Computed once here and reused for
# the summary tree below - the index does not change again after this point.
TREE="$(git write-tree)"
STAGED_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/mivia-precommit-staged.XXXXXX")"
if ! git archive "$TREE" | tar -x -C "$STAGED_ROOT"; then
  rm -rf "$STAGED_ROOT"
  fail "could not materialize the staged tree for isolated gates"
fi

# Independent read-only gates run together; wait preserves every diagnostic and
# fails only after all results are collected, reducing serial gate latency.
TMP_GATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/mivia-precommit.XXXXXX")"
cleanup() { rm -rf "$TMP_GATE_DIR" "$STAGED_ROOT"; }
trap cleanup EXIT
run_gate() {
  local name="$1"; shift
  run_verify "$@" >"$TMP_GATE_DIR/$name.out" 2>&1 &
  printf '%s:%s\n' "$name" "$!" >>"$TMP_GATE_DIR/pids"
}
run_gate config python3 "$STAGED_ROOT/scripts/verify_agent_config.py"
# secret_scan.py --staged already reads staged blobs via `git show :path`, not
# working-tree content, so it runs against the real repo unchanged - no
# isolation copy needed for this one.
run_gate secrets python3 scripts/secret_scan.py --staged
run_gate size python3 scripts/git-hooks/file-size-check --dir "$STAGED_ROOT"
run_gate structure python3 "$STAGED_ROOT/scripts/check_go_structure.py" --strict --worktree
gate_status=0
while IFS=: read -r name pid; do
  if ! wait "$pid"; then
    cat "$TMP_GATE_DIR/$name.out" >&2
    gate_status=1
  fi
done <"$TMP_GATE_DIR/pids"
if ((gate_status)); then
  fail "one or more parallel pre-commit gates failed"
fi

mapfile -d '' STAGED_DOCS < <(
  git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '^docs/' | tr '\n' '\0' || true
)
if ((${#STAGED_DOCS[@]})); then
  run_verify python3 "$STAGED_ROOT/scripts/check_docs_ownership.py"
fi

# Any Markdown file can restate the chat event vocabulary, and one already
# restated it wrongly. The Go conformance test cannot see prose, so this runs
# on staged Markdown as well as on the contract itself. It is milliseconds.
mapfile -d '' STAGED_VOCAB < <(
  git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '(\.md$|^api/contracts/|^\.mivia/policy/wire-vocabulary\.json$)' | tr '\n' '\0' || true
)
if ((${#STAGED_VOCAB[@]})); then
  run_verify python3 "$STAGED_ROOT/scripts/check_wire_vocabulary.py" --root "$STAGED_ROOT" --policy "$STAGED_ROOT/.mivia/policy/wire-vocabulary.json"
fi

SEMGREP_SUMMARY="semgrep skipped (not installed)"
# An engine crash (e.g. io_uring_queue_init ENOMEM under a low RLIMIT_MEMLOCK
# in containers/sandboxes) is an environment problem, not a repository defect.
# Detect it from the engine banners and skip with a loud warning, matching the
# "semgrep not installed" branch. Findings and rule-config errors never match
# these banners and must still fail the gate.
semgrep_engine_failure() {
  [[ -s "$1" ]] || return 1
  grep -qE 'semgrep-core exited with|Uncaught exn in Core_scan\.scan|engine was killed|Cannot allocate memory io_uring_queue_init' "$1"
}
if command -v semgrep >/dev/null 2>&1; then
  if [[ -f "$STAGED_ROOT/semgrep/agent-standards.yml" ]]; then
    SEMGREP_LOG="$TMP_GATE_DIR/semgrep.out"
    if run_verify semgrep --validate --config "$STAGED_ROOT/semgrep/agent-standards.yml" -j 1 >"$SEMGREP_LOG" 2>&1; then
      # Scan the whole isolated staged-tree directory rather than an
      # explicit file list: semgrep's own directory walk skips symlinks on
      # its own (no manual filtering needed, unlike passing a symlink path
      # directly), and every path in this directory is exactly what would
      # be committed - no staged/unstaged distinction left to get wrong.
      # -j 2 bounds semgrep-core's worker domains: on hosts with a low
      # RLIMIT_MEMLOCK (containers, sandboxes) the default per-CPU worker
      # count fails io_uring_queue_init with ENOMEM.
      if run_verify semgrep --config "$STAGED_ROOT/semgrep/agent-standards.yml" \
          --error --skip-unknown-extensions --metrics off --disable-nosem -j 2 \
          --exclude semgrep/agent-standards.yml \
          "$STAGED_ROOT" >"$SEMGREP_LOG" 2>&1; then
        SEMGREP_SUMMARY="staged semgrep 0 findings"
      elif semgrep_engine_failure "$SEMGREP_LOG"; then
        printf 'pre-commit: ⚠ semgrep engine unavailable (%s); staged scan skipped\n' "$(sed -n '1p' "$SEMGREP_LOG")" >&2
        SEMGREP_SUMMARY="semgrep skipped (engine unavailable)"
      else
        cat "$SEMGREP_LOG" >&2
        fail "semgrep scan failed (findings or error)"
      fi
    elif semgrep_engine_failure "$SEMGREP_LOG"; then
      printf 'pre-commit: ⚠ semgrep engine unavailable (%s); validate skipped\n' "$(sed -n '1p' "$SEMGREP_LOG")" >&2
      SEMGREP_SUMMARY="semgrep skipped (engine unavailable)"
    else
      cat "$SEMGREP_LOG" >&2
      fail "semgrep config validation failed"
    fi
  else
    SEMGREP_SUMMARY="semgrep skipped (no config)"
  fi
else
  printf 'pre-commit: semgrep not installed; staged scan skipped (pre-push requires it when config exists)\n' >&2
fi

# Invariant auto-detect: run area-specific tests for staged files, against
# the isolated staged tree (not the working tree) so an unstaged edit under
# one of these packages cannot make a compiled/tested binary diverge from
# what is actually being committed. Only runs if 'go' is available and at
# least one invariant area is staged.
INVARIANT_SUMMARY="invariants skipped"
if command -v go >/dev/null 2>&1; then
  STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
  INV_FAIL=0
  if echo "$STAGED" | grep -qE '^internal/cli/'; then
    echo " → Running TUI invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestBridgePath|TestPollCmd|TestBridgeDrain|TestUIEventMsg|TestFinishStream|TestTUISmoke' ./internal/cli/ -count=1 -timeout=120s) || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/tools/'; then
    echo " → Running tool invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestToolSurface|TestRedactToolInput|TestSearchLocalSkips|TestSearchOpenAI' ./internal/tools/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/agent/'; then
    echo " → Running agent invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestRedactToolInput|TestDelegateToolMultiStep|TestMultiStepHandler|TestSDKTurnShaping' ./internal/agent/ -count=1 -timeout=90s) || INV_FAIL=1
  fi
  # internal/provider had NO entry here, so a provider-only commit ran zero
  # provider tests at commit time. That is how a transport change capped every
  # non-stream generation at the response-header bound and reached main. The
  # conformance suite is the one that matters most: it is the only test that
  # holds EVERY Completer implementation to the same contract, which is where
  # this package keeps diverging.
  if echo "$STAGED" | grep -qE '^internal/provider/'; then
    echo " → Running provider invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestCompleterConformance|TestIsTransportStageTimeout|TestStdlibTimerErrorIdentities|TestCompatBaseRoundTripper' ./internal/provider/ -count=1 -timeout=120s) || INV_FAIL=1
  fi
  # Cross-kind delivery order is a LIVENESS contract that only shows up as a
  # wrong-looking UI two processes away: a turn terminal delivered before the
  # deltas it terminates makes a viewer close a turn and then render into it.
  # SubscribeAcross buys that order with one queue under many kinds, which in
  # turn makes a partial Unsubscribe silently feed a queue nobody drains. Both
  # are cheap to check and impossible to notice by reading.
  if echo "$STAGED" | grep -qE '^internal/events/'; then
    echo " → Running event-bus ordering invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestSubscribeAcrossPreservesCrossKindOrder|TestUnsubscribeRemovesSubscriptionFromEveryKind|TestBusUnsubscribeByHandlerRemovesEveryKind|TestDeliveryUnsubscribeRemovesSubscriptionFromEveryKind' ./internal/events/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # internal/hub is the consumer that spends the order SubscribeAcross buys.
  # Everything below the relay's broadcast boundary is order-preserving by
  # construction, so the bus subscription is the only hop that can reorder -
  # and reverting it to SubscribeMany compiles, passes vet, and only shows up
  # as duplicated turns on a second surface.
  # A gate script that calls rg/grep with no search path reads STDIN instead of
  # the tree whenever stdin is not a tty - so it blocks forever in CI or a hook,
  # or returns zero matches and reads as a pass. This shipped twice, both on the
  # verify chain. The check is milliseconds; the failure mode is a gate that can
  # never report.
  if echo "$STAGED" | grep -qE '^scripts/.*\.py$'; then
    echo " → Running subprocess-stdin gate..."
    (cd "$STAGED_ROOT" && run_verify python3 scripts/check_subprocess_stdin.py </dev/null) || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/hub/'; then
    echo " → Running hub relay ordering invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestRelayPreservesCrossKindPublishOrder|TestOwnerStopReleasesTheRelaySubscription|TestClientStopReleasesTheRelaySubscription|TestTurnTerminalsAreRelayed|TestSendStampsAMonotonicLossCount|TestRelayChargesBusLossOnlyToEventsThatPassedThroughIt' ./internal/hub/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # The viewer-surface conformance table. It runs whenever a kind, a surface,
  # or the policy that lets a surface stay silent is touched - the three ways a
  # kind gets added on one side and forgotten on the others. It is the gate for
  # a class that has shipped four times here (a kind reaching one viewer of
  # four, an arm with no allowlist entry, an allowlist entry with no arm).
  if echo "$STAGED" | grep -qE '^(internal/(agent|clichat|hub|uiadapter|events)/|\.mivia/policy/viewer-surfaces\.json$)'; then
    echo " → Running viewer-surface conformance tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestEveryEventKindReachesEveryViewerOrSaysWhyNot|TestTheRelayAllowlistAndItsRendererAgree' ./internal/clichat/ -count=1 -timeout=60s) || INV_FAIL=1
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestAllEventKindsMatchesTheDeclaredConstants' ./internal/agent/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # The tool-execution conformance table. Two code paths execute a model's
  # tool call and share no Go interface, so nothing named them siblings and
  # nine bugs shipped from the second one honouring four of nine contracts.
  # It runs whenever either path, the wiring that routes between them, or the
  # policy recording their declared divergences is touched.
  if echo "$STAGED" | grep -qE '^(internal/(chat|agent|clichat)/|\.mivia/policy/tool-execution-conformance\.json$)'; then
    echo " → Running tool-execution conformance tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestEveryPath' ./internal/clichat/ -count=1 -timeout=60s) || INV_FAIL=1
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestNoToolReachesTheModelUngoverned' ./internal/agent/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # The wire-field source check: every string leaving this machine must pass
  # through applyTruncation. Two fields have skipped it, each rejecting a
  # hundred-event batch at the receiving column, and both regression suites
  # missed both because they enumerate shapes by hand.
  if echo "$STAGED" | grep -qE '^(internal/chatsync/|\.mivia/policy/wire-field-sources\.json$)'; then
    echo " → Running wire-field source invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestNoWirePayloadStringComesStraightFromTheEvent|TestNoWireFieldCarriesANulByte|TestNoEventExceedsTheStoredPayloadBound' ./internal/chatsync/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/coordinator/'; then
    echo " → Running coordinator invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestDrainSeesQueuedMessage|TestPendingInterruptPreservesQueueContents' ./internal/coordinator/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # Task identity has two forms (full namespaced TaskID vs stripped RawID),
  # and a result-producer lookup keyed by the wrong one compiles and misses
  # silently (DC-11) - the recovered path shipped that twice. The conformance
  # suite is the gate that holds EVERY producer to the same attachment
  # contract; the wire-contract test pins the envelope bytes uiadapter
  # mirrors by hand (INV-TUI-29 forbids the import).
  if echo "$STAGED" | grep -qE '^internal/cliorchestrate/'; then
    echo " → Running orchestration result-envelope invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestTaskResultProducerConformance|TestTaskResultEnvelopeWireContract' ./internal/cliorchestrate/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # Any staged Go change can add an exec; the gate walks internal/ whole, so
  # it is keyed on Go files rather than one directory.
  #
  # This read `echo ""`, which matches nothing, so the gate ran on ZERO commits
  # from the day it was added - the anti-pattern the gate-authoring skill names
  # first: a gate that cannot fail. It passes on the current tree, so nothing
  # slipped through while it was dark, but nothing was watching either.
  if echo "$STAGED" | grep -qE '^internal/.*\.go$'; then
    echo " → Running exec pipe-bound gate..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestEveryExecBoundsItsPipeWait' ./internal/evidencecheck/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/subagents/'; then
    echo " → Running subagent invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestTerminalStatus|TestBuildResult|TestHandlerRequestFieldParity|TestHandlerParityPolicyHasNoStaleExemptions|TestOneShotHandler' ./internal/subagents/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # Windows fails a rename over a file a concurrent writer is renaming onto
  # (DC-14); the marker publish absorbs that with a bounded retry that only
  # Windows CI would otherwise exercise, intermittently. The gate proves the
  # retry deterministically on every platform.
  if echo "$STAGED" | grep -qE '^internal/cliworktree/'; then
    echo " → Running worktree marker publish invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestMarkerPublishRetriesTransientRenameContention' ./internal/cliworktree/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/chat/'; then
    echo " → Running chat invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestSessionMessages' ./internal/chat/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  # The chat-sync event vocabulary is published to a web client through
  # api/contracts/chat-sessions.v1.json, and the API names each SSE frame after
  # the event type string - so a type the client does not know is an event it
  # never receives. The vocabulary already drifted once in a third copy. This
  # is keyed on the contract file as well as the package, because editing the
  # JSON alone is exactly the edit that must not go unchecked.
  if echo "$STAGED" | grep -qE '^(internal/chatsync/|api/contracts/)'; then
    echo " → Running chat-sync wire vocabulary invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestEveryWireTypeConstantIsInTheEventTable|TestKnownWireTypesIsDerivedFromTheEventTable|TestKnownWireTypesMatchContractSnapshot|TestWireEnvelopeMatchesContractSnapshot|TestWireSharedObjectsMatchContractSnapshot|TestWireEventPayloadsMatchContractSnapshot' ./internal/chatsync/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/config/'; then
    echo " → Running config invariant tests..."
    (cd "$STAGED_ROOT" && run_verify go test -run 'TestPrivacyRedact' ./internal/config/ -count=1 -timeout=60s) || INV_FAIL=1
  fi
  if ((INV_FAIL)); then
    fail "one or more invariant tests failed"
  fi
  INVARIANT_SUMMARY="invariants ok"
fi

# Mutation sweep on the staged diff. Applies text-level operator mutations
# ONLY to lines this commit adds or edits - verbatim-moved lines (the same
# bytes deleted elsewhere in the diff) are skipped, so a refactor commit's
# sweep cost tracks semantic change, not text churn - runs each mutant's
# package test target, and fails if a mutant survives with no test noticing - the one
# check generic enough to catch "the test asserts on the wrong thing" or "the
# fixture disables the very guard it means to test" without knowing the
# defect class in advance. It was already wired into `make verify`
# (scripts/check_mutation.py --staged) but nothing ran `make verify`
# interactively, so it never fired on an ordinary commit. This is that gap
# closed: it runs here, on every commit, scoped to what that commit actually
# changes so cost stays proportional to diff size, not repo size.
#
# Runs from ROOT, not STAGED_ROOT: it drives `git diff --cached` itself and
# transiently mutates the real working-tree file, restoring it in a `finally`
# even on SIGTERM - it needs the real .git directory and working tree, which
# STAGED_ROOT (a bare `git archive` extraction with no .git) does not have.
# MOVED TO pre-push. The sweep runs one `go test` per mutation site, so its
# cost scales with the diff, and a broad commit (a multi-package change, or a
# backlog landed in one go) ran it past ten minutes - long enough that the
# supervisor killed it and the commit failed with a timeout traceback instead
# of a verdict. A gate that cannot finish is not enforcing anything, and one
# that makes every commit unaffordable gets bypassed, which is worse than
# moving it.
#
# It is NOT weakened: pre-push runs the same sweep over the full push range
# before any code leaves this machine, which is the boundary that matters.
# Commits stay local and cheap; nothing reaches a remote unswept.
MUTATION_SUMMARY="mutation check deferred to pre-push"

printf 'tree=%s\nsummary=%s\n' \
  "$TREE" \
  "Quality: pre-commit passed (agent config, secret scan, docs when staged, whitespace, contract tests, ${SEMGREP_SUMMARY}; ${GOFMT_SUMMARY}; ${INVARIANT_SUMMARY}; ${MUTATION_SUMMARY})" \
  >"$SUMMARY_FILE"
