#!/usr/bin/env bash
# mivia pre-commit: fast deterministic checks first, then independent static gates.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if [[ -d "${HOME:-}/.local/bin" ]]; then
  PATH="${HOME}/.local/bin:${PATH}"
  export PATH
fi

# --no-invariants bypass: logs to .git/invariant-bypass-log and skips
for arg in "$@"; do
  if [ "$arg" = "--no-invariants" ]; then
    BYPASS_LOG="$(git rev-parse --git-dir)/invariant-bypass-log"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) BYPASS ${USER:-unknown} $(git rev-parse HEAD)" >> "$BYPASS_LOG"
    printf 'pre-commit: ⚠ Invariant bypass logged to %s\n' "$BYPASS_LOG" >&2
    exit 0
  fi
done

SUMMARY_FILE="$(git rev-parse --git-path mivia-precommit-summary)"
rm -f "$SUMMARY_FILE"

fail() {
  printf 'pre-commit: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command '$1'"
}

require_cmd python3
run_verify() { "$ROOT/scripts/git-hooks/run_without_git_env" "$@"; }

# These checks are cheap and mutate the index (gofmt), so run them before scans.
git diff --check --cached
mapfile -d '' GO_FILES < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.go')
if ((${#GO_FILES[@]})); then
  require_cmd gofmt
  # Fully staged files keep the auto-format + re-add path. Partially staged
  # files (unstaged hunks present) must NEVER be re-added: `git add -- file`
  # stages the whole working-tree file and silently overstages unstaged hunks.
  # For those, format only the staged blob (git show :file | gofmt) into a new
  # blob (git hash-object -w) and rewrite only the index entry with the real
  # mode from `git ls-files -s` (first field, never hardcoded), skipping the
  # update when the formatted hash equals the current staged hash. The
  # working-tree file is never touched, so unstaged hunks stay unstaged while
  # the committed tree stays gofmt-clean.
  for file in "${GO_FILES[@]}"; do
    if git diff --quiet -- "$file"; then
      gofmt -w "$file"
      git add -- "$file"
    else
      mode="$(git ls-files -s -- "$file" | awk '{print $1}')"
      current="$(git rev-parse :"$file")"
      formatted="$(git show :"$file" | gofmt | git hash-object -w --stdin)"
      if [ "$formatted" != "$current" ]; then
        git update-index --cacheinfo "$mode" "$formatted" "$file"
      fi
    fi
  done
  git diff --check --cached
  GOFMT_SUMMARY="gofmt ${#GO_FILES[@]} file(s)"
else
  GOFMT_SUMMARY="gofmt skipped"
fi

# Plan 76 (D6): keep a reviewable JSONL export in sync with the committed
# sqlite memory database, in the same commit as any change to it, so the
# size gate below sees the freshly staged export too. `go run` avoids a
# dependency on a prebuilt ./mivia binary (pre-commit has no existing
# mivia-build step to reuse).
#
# Dumps the STAGED blob (`git show :.mivia/memory.db`), not the working-tree
# file - found in Step 5 hostile review: dumping the working-tree copy
# directly would let a concurrent write to memory.db (another mivia session
# saving a memory between `git add` and `git commit`, without re-staging)
# produce a jsonl that describes content never actually staged, diverging
# silently from the committed .db blob.
# Auto-stage a modified .mivia/memory.db that the caller forgot to `git add`,
# so every commit picks up the latest memory store instead of silently
# leaving it behind. Only a working-tree modification to a tracked file is
# staged here - never an untracked/new file, and never a deletion - so this
# cannot turn an unrelated commit into one that adds or removes the db.
if git diff --name-only --diff-filter=M -- .mivia/memory.db | grep -qx '\.mivia/memory\.db'; then
  git add -- .mivia/memory.db
fi

if git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -qx '\.mivia/memory\.db'; then
  DUMP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/mivia-memory-dump.XXXXXX")"
  # A self-contained trap: the later TMP_GATE_DIR cleanup() / trap (below)
  # isn't defined yet at this point in the script, so this must not depend
  # on it. Fires on any exit from this block, including `fail`'s exit 1.
  trap 'rm -rf "$DUMP_TMP"' EXIT
  mkdir -p "$DUMP_TMP/.mivia"
  if ! git show ":.mivia/memory.db" >"$DUMP_TMP/.mivia/memory.db"; then
    fail "could not read the staged .mivia/memory.db blob"
  fi
  if ! (cd "$ROOT" && go run ./cmd/mivia memory dump --workspace "$DUMP_TMP" >"$ROOT/.mivia/memory.jsonl"); then
    fail "memory dump failed while staging .mivia/memory.db"
  fi
  rm -rf "$DUMP_TMP"
  trap - EXIT
  git add "$ROOT/.mivia/memory.jsonl"
fi

# Independent read-only gates run together; wait preserves every diagnostic and
# fails only after all results are collected, reducing serial gate latency.
TMP_GATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/mivia-precommit.XXXXXX")"
cleanup() { rm -rf "$TMP_GATE_DIR"; }
trap cleanup EXIT
run_gate() {
  local name="$1"; shift
  run_verify "$@" >"$TMP_GATE_DIR/$name.out" 2>&1 &
  printf '%s:%s\n' "$name" "$!" >>"$TMP_GATE_DIR/pids"
}
run_gate config python3 scripts/verify_agent_config.py
run_gate secrets python3 scripts/secret_scan.py --staged
run_gate size python3 scripts/git-hooks/file-size-check
run_gate structure python3 scripts/check_go_structure.py --strict --staged
gate_status=0
while IFS=: read -r name pid; do
  if ! wait "$pid"; then
    cat "$TMP_GATE_DIR/$name.out" >&2
    gate_status=1
  fi
done <"$TMP_GATE_DIR/pids"
if ((gate_status)); then
  fail "one or more parallel pre-commit gates failed"
fi

mapfile -d '' STAGED_DOCS < <(
  git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '^docs/' | tr '\n' '\0' || true
)
if ((${#STAGED_DOCS[@]})); then
  run_verify python3 scripts/check_docs_ownership.py --staged
fi

SEMGREP_SUMMARY="semgrep skipped (not installed)"
# An engine crash (e.g. io_uring_queue_init ENOMEM under a low RLIMIT_MEMLOCK
# in containers/sandboxes) is an environment problem, not a repository defect.
# Detect it from the engine banners and skip with a loud warning, matching the
# "semgrep not installed" branch. Findings and rule-config errors never match
# these banners and must still fail the gate.
semgrep_engine_failure() {
  [[ -s "$1" ]] || return 1
  grep -qE 'semgrep-core exited with|Uncaught exn in Core_scan\.scan|engine was killed|Cannot allocate memory io_uring_queue_init' "$1"
}
if command -v semgrep >/dev/null 2>&1; then
  if [[ -f semgrep/agent-standards.yml ]]; then
    SEMGREP_LOG="$TMP_GATE_DIR/semgrep.out"
    if run_verify semgrep --validate --config semgrep/agent-standards.yml -j 1 >"$SEMGREP_LOG" 2>&1; then
      mapfile -d '' STAGED_FILES < <(
        git diff --cached --name-only --diff-filter=ACMR -z -- ':!semgrep/agent-standards.yml'
      )
      # BEGIN symlink filter (extracted verbatim by test_git_hooks.py's
      # extract_symlink_filter): semgrep refuses to scan a symlink path
      # directly ("Semgrep skips symbolic links to avoid scanning the same
      # file twice... pass the target it points to directly"), so a staged
      # symlink (e.g. a skill alias under .claude/skills or .agents/skills)
      # fails the whole gate with an engine error, not a real finding.
      # Filter staged symlinks out of the scan set: a symlink has no source
      # bytes of its own to match rules against, and its target - if itself
      # staged as a regular file - is scanned on its own path already.
      if ((${#STAGED_FILES[@]})); then
        NON_SYMLINK_STAGED_FILES=()
        for f in "${STAGED_FILES[@]}"; do
          [[ -L "$f" ]] || NON_SYMLINK_STAGED_FILES+=("$f")
        done
        STAGED_FILES=("${NON_SYMLINK_STAGED_FILES[@]}")
      fi
      # END symlink filter
      if ((${#STAGED_FILES[@]})); then
        # -j 2 bounds semgrep-core's worker domains: on hosts with a low
        # RLIMIT_MEMLOCK (containers, sandboxes) the default per-CPU worker
        # count fails io_uring_queue_init with ENOMEM. Two workers scan any
        # staged set reliably and the whole tree at an acceptable pace.
        if run_verify semgrep --config semgrep/agent-standards.yml \
            --error --skip-unknown-extensions --metrics off --disable-nosem -j 2 \
            "${STAGED_FILES[@]}" >"$SEMGREP_LOG" 2>&1; then
          SEMGREP_SUMMARY="staged semgrep 0 findings"
        elif semgrep_engine_failure "$SEMGREP_LOG"; then
          printf 'pre-commit: ⚠ semgrep engine unavailable (%s); staged scan skipped\n' "$(sed -n '1p' "$SEMGREP_LOG")" >&2
          SEMGREP_SUMMARY="semgrep skipped (engine unavailable)"
        else
          cat "$SEMGREP_LOG" >&2
          fail "semgrep scan failed (findings or error)"
        fi
      else
        SEMGREP_SUMMARY="semgrep validated (no staged scan targets)"
      fi
    elif semgrep_engine_failure "$SEMGREP_LOG"; then
      printf 'pre-commit: ⚠ semgrep engine unavailable (%s); validate skipped\n' "$(sed -n '1p' "$SEMGREP_LOG")" >&2
      SEMGREP_SUMMARY="semgrep skipped (engine unavailable)"
    else
      cat "$SEMGREP_LOG" >&2
      fail "semgrep config validation failed"
    fi
  else
    SEMGREP_SUMMARY="semgrep skipped (no config)"
  fi
else
  printf 'pre-commit: semgrep not installed; staged scan skipped (pre-push requires it when config exists)\n' >&2
fi

# Invariant auto-detect: run area-specific tests for staged files.
# Only runs if 'go' is available and at least one invariant area is staged.
INVARIANT_SUMMARY="invariants skipped"
if command -v go >/dev/null 2>&1; then
  STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
  INV_FAIL=0
  if echo "$STAGED" | grep -qE '^internal/cli/'; then
    echo " → Running TUI invariant tests..."
    run_verify go test -run 'TestBridgePath|TestPollCmd|TestBridgeDrain|TestUIEventMsg|TestFinishStream|TestTUISmoke' ./internal/cli/ -count=1 -timeout=120s || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/tools/'; then
    echo " → Running tool invariant tests..."
    run_verify go test -run 'TestToolSurface|TestRedactToolInput|TestSearchLocalSkips|TestSearchOpenAI' ./internal/tools/ -count=1 -timeout=60s || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/agent/'; then
    echo " → Running agent invariant tests..."
    run_verify go test -run 'TestRedactToolInput|TestDelegateToolMultiStep|TestMultiStepHandler' ./internal/agent/ -count=1 -timeout=60s || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/chat/'; then
    echo " → Running chat invariant tests..."
    run_verify go test -run 'TestSessionMessages' ./internal/chat/ -count=1 -timeout=60s || INV_FAIL=1
  fi
  if echo "$STAGED" | grep -qE '^internal/config/'; then
    echo " → Running config invariant tests..."
    run_verify go test -run 'TestPrivacyRedact' ./internal/config/ -count=1 -timeout=60s || INV_FAIL=1
  fi
  if ((INV_FAIL)); then
    fail "one or more invariant tests failed"
  fi
  INVARIANT_SUMMARY="invariants ok"
fi

TREE="$(git write-tree)"
printf 'tree=%s\nsummary=%s\n' \
  "$TREE" \
  "Quality: pre-commit passed (agent config, secret scan, docs when staged, whitespace, contract tests, ${SEMGREP_SUMMARY}; ${GOFMT_SUMMARY}; ${INVARIANT_SUMMARY})" \
  >"$SUMMARY_FILE"
