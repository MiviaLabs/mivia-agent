#!/usr/bin/env bash
# mivia pre-push: full offline gate (fail closed).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if [[ -d "${HOME:-}/.local/bin" ]]; then
  PATH="${HOME}/.local/bin:${PATH}"
  export PATH
fi

fail() {
  printf 'pre-push: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command '$1'"
}

run_verify() { "$ROOT/scripts/git-hooks/run_without_git_env" "$@"; }

require_cmd python3

# Secret scan: merge-base range when available, else all tracked files.
# Git hands the refs being pushed on stdin, one
# `<local ref> <local sha> <remote ref> <remote sha>` line per ref. Read them
# HERE, before any child process runs: a child that reads stdin would consume
# the lines and this hook would silently fall back to sweeping HEAD. The
# supervisor (run_with_timeout) forwards its stdin to the job for the same
# reason.
# A delete (local sha all zeros) has nothing to scan and builds no range.
# "A ref line was read" below means "a non-delete line was read", so a
# delete-only push takes the HEAD fallback.
# A Mivia-managed worktree must not use HEAD^ as a base. That base can
# hide files from earlier commits on a new branch. Use the remote's sha
# when it exists locally, else the pushed ref's upstream, else an origin
# base, anchored on the PUSHED sha rather than HEAD. A pushed ref with no
# base at all is scanned --tracked rather than dropped.
# MIVIA_PUSH_VERIFY_BASE/TIP override all automatic detection.
ZERO_SHA='0000000000000000000000000000000000000000'
PUSH_BASES=()
PUSH_TIPS=()
if [[ ! -t 0 ]]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "$local_sha" && "$local_sha" != "$ZERO_SHA" ]] || continue
    if [[ -n "$remote_sha" && "$remote_sha" != "$ZERO_SHA" ]] \
        && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      push_base="$(git merge-base "$local_sha" "$remote_sha" 2>/dev/null || true)"
    else
      push_base="$(
        git merge-base "$local_sha" "${local_ref#refs/heads/}@{upstream}" 2>/dev/null \
        || git merge-base "$local_sha" origin/main 2>/dev/null \
        || git merge-base "$local_sha" origin/master 2>/dev/null \
        || true
      )"
    fi
    PUSH_BASES+=("$push_base")
    PUSH_TIPS+=("$local_sha")
  done
fi
if [[ -n "${MIVIA_PUSH_VERIFY_BASE:-}" && -n "${MIVIA_PUSH_VERIFY_TIP:-}" ]]; then
  PUSH_BASES=("$MIVIA_PUSH_VERIFY_BASE")
  PUSH_TIPS=("$MIVIA_PUSH_VERIFY_TIP")
elif ((${#PUSH_TIPS[@]} == 0)); then
  if [[ ! -t 0 ]]; then
    printf 'pre-push: no ref lines on stdin; sweeping HEAD\n' >&2
  fi
  PUSH_BASES=("$(
    git merge-base HEAD '@{upstream}' 2>/dev/null \
    || git merge-base HEAD origin/main 2>/dev/null \
    || git merge-base HEAD origin/master 2>/dev/null \
    || true
  )")
  PUSH_TIPS=("HEAD")
fi

TRACKED_SCANNED=0
for i in "${!PUSH_TIPS[@]}"; do
  if [[ -n "${PUSH_BASES[$i]}" ]]; then
    run_verify python3 scripts/secret_scan.py --base "${PUSH_BASES[$i]}" --tip "${PUSH_TIPS[$i]}"
  elif ((TRACKED_SCANNED == 0)); then
    run_verify python3 scripts/secret_scan.py --tracked
    TRACKED_SCANNED=1
  fi
done

run_verify python3 scripts/verify_agent_config.py
run_verify python3 scripts/check_memories.py
run_verify python3 scripts/git-hooks/file-size-check --tracked
run_verify python3 scripts/check_go_structure.py --strict --all

git diff --check

run_verify python3 scripts/check_docs_ownership.py

run_verify python3 scripts/test_git_hooks.py
run_verify python3 scripts/test_agent_hook_guard.py
run_verify python3 scripts/test_secret_scan.py
run_verify python3 scripts/test_docs_ownership.py
run_verify python3 scripts/test_verify_skill_tree.py
run_verify python3 scripts/test_check_provider_docs.py
run_verify python3 scripts/test_semgrep_rules.py

# An engine crash (e.g. io_uring_queue_init ENOMEM under a low RLIMIT_MEMLOCK
# in containers/sandboxes) is an environment problem, not a repository defect.
# Detect it from the engine banners and skip with a loud warning, matching the
# "semgrep not installed" branch. Findings and rule-config errors never match
# these banners and must still fail the gate.
semgrep_engine_failure() {
  [[ -s "$1" ]] || return 1
  grep -qE 'semgrep-core exited with|Uncaught exn in Core_scan\.scan|engine was killed|Cannot allocate memory io_uring_queue_init' "$1"
}
if [[ -f semgrep/agent-standards.yml ]]; then
  require_cmd semgrep
  SEMGREP_LOG="$(mktemp "${TMPDIR:-/tmp}/mivia-prepush-semgrep.XXXXXX")"
  trap 'rm -f "$SEMGREP_LOG"' EXIT
  if run_verify semgrep --validate --config semgrep/agent-standards.yml -j 1 >"$SEMGREP_LOG" 2>&1; then
    # -j 2 bounds semgrep-core's worker domains: default per-CPU workers fail
    # io_uring_queue_init (ENOMEM) under a low RLIMIT_MEMLOCK (containers).
    if run_verify semgrep --config semgrep/agent-standards.yml \
        --error --skip-unknown-extensions --metrics off --disable-nosem -j 2 . >"$SEMGREP_LOG" 2>&1; then
      :
    elif semgrep_engine_failure "$SEMGREP_LOG"; then
      printf 'pre-push: ⚠ semgrep engine unavailable (%s); scan skipped\n' "$(sed -n '1p' "$SEMGREP_LOG")" >&2
    else
      cat "$SEMGREP_LOG" >&2
      fail "semgrep scan failed (findings or error)"
    fi
  elif semgrep_engine_failure "$SEMGREP_LOG"; then
    printf 'pre-push: ⚠ semgrep engine unavailable (%s); validate skipped\n' "$(sed -n '1p' "$SEMGREP_LOG")" >&2
  else
    cat "$SEMGREP_LOG" >&2
    fail "semgrep config validation failed"
  fi
else
  printf 'pre-push: semgrep/agent-standards.yml missing; skipping semgrep scan\n' >&2
fi

# Invariant validation (manifest cross-reference + invariant tests)
if command -v go >/dev/null 2>&1; then
  pushd "$ROOT" >/dev/null
  run_verify make validate-invariants
  run_verify make invariants
  popd >/dev/null
else
  printf 'pre-push: go not found; skipping invariant validation\n' >&2
fi

if [[ ! -f go.mod ]]; then
  printf 'pre-push: go.mod not present; skipping Go test/vet/build\n'
  exit 0
fi

run_go_gates() {
  require_cmd go
  mapfile -d '' GO_FILES < <(git ls-files -z -- '*.go')
  if ((${#GO_FILES[@]})); then
    UNFORMATTED="$(gofmt -l "${GO_FILES[@]}")"
    if [[ -n "$UNFORMATTED" ]]; then
      printf 'pre-push: gofmt required for:\n%s\n' "$UNFORMATTED" >&2
      return 1
    fi
  fi
  run_verify go test ./...
  run_verify go vet ./...
  if [[ -d cmd/mivia ]]; then
    run_verify go build -o /dev/null ./cmd/mivia
  fi

  # Mutation sweep, moved here from pre-commit. It runs one `go test` per
  # mutation site, so its cost scales with the diff; on a broad change that ran
  # past ten minutes on EVERY commit, until the supervisor killed it and the
  # commit failed with a timeout traceback rather than a verdict. A gate that
  # cannot finish enforces nothing, and one that makes committing unaffordable
  # gets bypassed.
  #
  # This is the same sweep, at the boundary that actually matters: nothing
  # reaches a remote unswept. It sweeps the PUSH RANGE rather than the index -
  # `--staged` reads `git diff --cached`, which is empty here - so it covers
  # every commit being pushed, not just the last one.
  if command -v go >/dev/null 2>&1; then
    # The same ranges the secret scan built from git's stdin ref lines (or
    # the HEAD fallback / env override). The arrays are shell globals filled
    # before any child ran; a pair with no base keeps the skip notice, since
    # there is nothing to diff that range against.
    local i
    for i in "${!PUSH_TIPS[@]}"; do
      if [[ -n "${PUSH_BASES[$i]}" ]]; then
        run_verify python3 "$ROOT/scripts/check_mutation.py" --base "${PUSH_BASES[$i]}" --tip "${PUSH_TIPS[$i]}"
      else
        printf 'pre-push: no base for a mutation range; skipping sweep\n' >&2
      fi
    done
  fi
}

case "$ROOT" in
  //wsl.localhost/*|\\\\wsl.localhost\\*)
    require_cmd wsl.exe
    DISTRO="${MIVIA_WSL_DISTRO:-Ubuntu}"
    NATIVE_ROOT="$(wsl.exe -d "$DISTRO" -- wslpath -u "$ROOT" | tr -d '\r')"
    [[ -n "$NATIVE_ROOT" ]] || fail "could not resolve UNC checkout to native WSL path"
    run_verify wsl.exe -d "$DISTRO" -- bash -lc "cd '$NATIVE_ROOT' && if git ls-files -z -- '*.go' | xargs -0 gofmt -l | grep -q .; then printf 'pre-push: gofmt required\n' >&2; exit 1; fi; go test ./... && go vet ./... && go build -o /dev/null ./cmd/mivia"
    ;;
  *)
    run_go_gates
    ;;
esac
