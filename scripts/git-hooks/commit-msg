#!/usr/bin/env bash
# mivia commit-msg: type(scope): imperative subject from .mivia/policy/commit-message.json
# On failure, always prints allowed types and scopes first so agents can self-correct.
set -euo pipefail

MSG_FILE="${1:?commit message file is required}"
ROOT="$(git rev-parse --show-toplevel)"
POLICY_FILE="$ROOT/.mivia/policy/commit-message.json"

# Remove disallowed Co-authored-by trailer lines (silent; Mivia Agent stays).
python3 "$ROOT/scripts/git-hooks/strip_coauthor.py" "$MSG_FILE"

export MSG_FILE POLICY_FILE
exec python3 - <<'PY'
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

msg_path = Path(os.environ["MSG_FILE"])
policy_path = Path(os.environ["POLICY_FILE"])


def load_policy() -> dict:
    try:
        data = json.loads(policy_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"commit-msg: cannot load policy {policy_path}: {exc}", file=sys.stderr)
        sys.exit(2)
    for key in ("types", "scopes", "maxSubjectLength"):
        if key not in data:
            print(f"commit-msg: policy missing {key}", file=sys.stderr)
            sys.exit(2)
    return data


def subject_line(text: str) -> str:
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        return line.strip()
    return ""


def print_catalog(policy: dict) -> None:
    types = ", ".join(policy["types"])
    scopes = ", ".join(policy["scopes"])
    print("commit-msg: allowed types:", types, file=sys.stderr)
    print("commit-msg: allowed scopes:", scopes, file=sys.stderr)
    guide = policy.get("scopeGuide") or {}
    if isinstance(guide, dict) and guide:
        print("commit-msg: scope guide:", file=sys.stderr)
        for name in policy["scopes"]:
            desc = guide.get(name, "")
            if desc:
                print(f"commit-msg:   {name}: {desc}", file=sys.stderr)
    print(
        "commit-msg: format: type(scope): imperative subject",
        file=sys.stderr,
    )
    print(
        f"commit-msg: policy: {policy_path.as_posix()}",
        file=sys.stderr,
    )
    required = policy.get("requiredTrailers") or {}
    if isinstance(required, dict) and required:
        for ctype, labels in required.items():
            print(
                f"commit-msg: required trailers for {ctype}: {', '.join(labels)}",
                file=sys.stderr,
            )
    examples = policy.get("examples") or []
    if examples:
        print("commit-msg: examples:", file=sys.stderr)
        for ex in examples[:6]:
            print(f"commit-msg:   {ex}", file=sys.stderr)


def has_trailer(raw: str, label: str) -> bool:
    """True when the body carries a non-empty `<label>: value` line.

    The subject is excluded, and so are comment and `Quality:` lines, which the
    pre-commit hook appends after the author wrote the message.
    """
    prefix = f"{label}:"
    for line in raw.splitlines()[1:]:
        if line.startswith("#") or line.startswith("Quality:"):
            continue
        stripped = line.strip()
        if stripped.startswith(prefix) and stripped[len(prefix):].strip():
            return True
    return False


def trailer_value(raw: str, label: str) -> str:
    """The text after `<label>:` in the body, or "" when absent."""
    prefix = f"{label}:"
    for line in raw.splitlines()[1:]:
        if line.startswith("#") or line.startswith("Quality:"):
            continue
        stripped = line.strip()
        if stripped.startswith(prefix):
            return stripped[len(prefix):].strip()
    return ""


def trailer_block(raw: str, label: str) -> str:
    """The trailer's value plus any continuation lines that follow it.

    A Sweep or Regression line routinely wraps across several lines. Reading
    only the first would judge the trailer on a fragment, so continuation
    lines - anything up to the next `Label:` line or a blank line - join it.
    """
    prefix = f"{label}:"
    collected: list[str] = []
    for line in raw.splitlines()[1:]:
        if line.startswith("#") or line.startswith("Quality:"):
            continue
        stripped = line.strip()
        if collected:
            if not stripped or re.match(r"^[A-Z][A-Za-z-]*:", stripped):
                break
            collected.append(stripped)
            continue
        if stripped.startswith(prefix):
            collected.append(stripped[len(prefix):].strip())
    return " ".join(collected).strip()


def says_none(value: str) -> bool:
    """True for the documented `none (<reason>)` escape hatch."""
    return value.lower().startswith("none")


def known_test_names(names: list[str]) -> list[str]:
    """Return the subset of names that do NOT resolve to a real test func.

    Searches the working tree's _test.go files, which is where a test added by
    this very commit already lives when the hook runs.
    """
    missing = []
    for name in names:
        try:
            found = subprocess.run(
                ["git", "grep", "-lE", rf"^func {re.escape(name)}\(", "--", "*_test.go"],
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError:
            return []  # git unavailable: do not block the commit on tooling
        if found.returncode != 0 or not found.stdout.strip():
            missing.append(name)
    return missing


def defect_classes(catalogue: str) -> set:
    """The DC-n identifiers the taxonomy actually defines."""
    path = Path(catalogue)
    if not path.is_file():
        return set()
    return set(re.findall(r"^#+\s*(DC-\d+)\b", path.read_text(encoding="utf-8"), re.M))


def check_trailer_content(policy: dict, ctype: str, raw: str) -> None:
    """Validate what a required trailer SAYS, not merely that it is present.

    Presence-only validation is why these trailers stopped carrying
    information: `Sweep: x` passed, and a `Regression:` naming a test that was
    never written passed too. Each rule below turns one self-attested claim
    into something that can be checked and can fail.
    """
    rules = policy.get("trailerRules") or {}
    required = (policy.get("requiredTrailers") or {}).get(ctype, [])
    for label in required:
        rule = rules.get(label)
        if not rule:
            continue
        value = trailer_block(raw, label)
        if not value or says_none(value):
            continue
        kind = rule.get("kind")
        if kind == "testNames":
            names = re.findall(r"\b(Test[A-Za-z0-9_]+)\b", value)
            if not names:
                trailer_fail(policy, label, rule,
                             "names no test; use \"Regression: Test<Name>\" or \"Regression: none (<reason>)\"")
            missing = known_test_names(names)
            if missing:
                trailer_fail(policy, label, rule,
                             "names a test that does not exist: " + ", ".join(missing))
        elif kind == "defectClass":
            declared = set(re.findall(r"\bDC-\d+\b", value))
            if not declared:
                trailer_fail(policy, label, rule,
                             "names no DC-n class; use \"Class: DC-n\" or \"Class: none (<reason>)\"")
            known = defect_classes(rule.get("catalogue", ""))
            unknown = sorted(declared - known) if known else []
            if unknown:
                trailer_fail(policy, label, rule,
                             "names a class the taxonomy does not define: " + ", ".join(unknown))
        elif kind == "countedSearch":
            counted = re.search(r"\d", value) or re.search(
                r"\bno (further|other|more)\b|\bnone\b", value, re.I)
            if len(value) < int(rule.get("minLength", 30)) or not counted:
                trailer_fail(policy, label, rule,
                             "must report a COUNT of other sites examined, e.g. "
                             "\"Sweep: searched <mechanism>, checked <sites>, found 0 further\"")


def trailer_fail(policy: dict, label: str, rule: dict, reason: str) -> None:
    print_catalog(policy)
    print(f"commit-msg: error: {label} trailer {reason}", file=sys.stderr)
    if rule.get("why"):
        print(f"commit-msg: why: {rule['why']}", file=sys.stderr)
    hint = (policy.get("trailerHints") or {}).get(label, "")
    if hint:
        print(f"commit-msg: fix-hint: {hint}", file=sys.stderr)
    sys.exit(1)


def fail(policy: dict, reason: str) -> None:
    # Catalog first - agents need the menu before the diagnosis.
    print_catalog(policy)
    print(f"commit-msg: error: {reason}", file=sys.stderr)
    # Print a fix template hint so agents can self-correct in one retry.
    if "longer than" in reason:
        print("commit-msg: fix-hint: shorten subject; use body paragraphs for detail", file=sys.stderr)
    elif "lowercase letter" in reason:
        print("commit-msg: fix-hint: change first word after ': ' to lowercase", file=sys.stderr)
    elif "end with a period" in reason:
        print("commit-msg: fix-hint: remove trailing period from subject", file=sys.stderr)
    elif "unknown type" in reason:
        print("commit-msg: fix-hint: pick a type from the allowed list above", file=sys.stderr)
    elif "unknown scope" in reason:
        print("commit-msg: fix-hint: pick a scope from the allowed list above", file=sys.stderr)
    elif "scope is required" in reason:
        print("commit-msg: fix-hint: add scope, e.g. feat(cli): your message", file=sys.stderr)
    elif "does not match" in reason:
        print("commit-msg: fix-hint: format must be type(scope): lowercase subject", file=sys.stderr)
    print(
        "commit-msg: fix-hint: dry-run first -> python3 scripts/git-hooks/check-commit-subject \\",
        file=sys.stderr,
    )
    print(
        'commit-msg: fix-hint:   "type(scope): lowercase subject under 72 chars"',
        file=sys.stderr,
    )
    sys.exit(1)


def main() -> int:
    policy = load_policy()
    types = list(policy["types"])
    scopes = list(policy["scopes"])
    max_len = int(policy["maxSubjectLength"])
    require_scope = bool(policy.get("requireScope", True))

    try:
        raw = msg_path.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"commit-msg: cannot read message file: {exc}", file=sys.stderr)
        return 2

    subject = subject_line(raw)
    if not subject:
        fail(policy, "empty commit subject")

    # Git-generated subjects
    if (
        subject.startswith("Merge ")
        or subject.startswith('Revert "')
        or subject.startswith("fixup! ")
        or subject.startswith("squash! ")
    ):
        return 0

    if len(subject) > max_len:
        fail(policy, f"subject is longer than {max_len} characters ({len(subject)})")

    # type(scope)!: subject  OR  type: subject when scope optional
    m = re.match(
        r"^(?P<type>[a-z]+)(?:\((?P<scope>[a-z0-9/-]+)\))?(?P<break>!)?: (?P<body>.+)$",
        subject,
    )
    if not m:
        fail(
            policy,
            "subject does not match type(scope): subject "
            f"(got {subject!r})",
        )

    ctype = m.group("type")
    scope = m.group("scope")
    body = m.group("body")

    if ctype not in types:
        fail(policy, f"unknown type {ctype!r}")

    if require_scope and not scope:
        fail(policy, "scope is required; use type(scope): subject")

    if scope is not None and scope not in scopes:
        fail(policy, f"unknown scope {scope!r}")

    if not body:
        fail(policy, "empty subject body after type(scope):")

    if not re.match(r"^[a-z0-9]", body):
        fail(policy, "subject body must start with a lowercase letter or digit")

    if body.endswith("."):
        fail(policy, "subject must not end with a period")

    # Append commit-message passed to Quality line when present.
    lines = raw.splitlines()
    for index, line in enumerate(lines):
        if not line.startswith("Quality: pre-commit passed "):
            continue
        if "commit message passed" in line:
            break
        line = line.rstrip()
        if line.endswith(")"):
            lines[index] = line[:-1] + ", commit message passed)"
        else:
            lines[index] = line + ", commit message passed)"
        break
    ending = "\n" if raw.endswith("\n") else ""
    msg_path.write_text("\n".join(lines) + ending, encoding="utf-8")

    # Trailers required per type by policy (Regression, Class, Sweep for fix).
    required = policy.get("requiredTrailers") or {}
    for label in required.get(ctype, []):
        if has_trailer(raw, label):
            continue
        hint = (policy.get("trailerHints") or {}).get(label, "")
        # Catalog first - agents need the menu before the diagnosis.
        print_catalog(policy)
        for name in required.get(ctype, []):
            guide = (policy.get("trailerGuide") or {}).get(name, "")
            if guide:
                print(f"commit-msg:   {name}: {guide}", file=sys.stderr)
        print(
            f"commit-msg: error: {ctype} commits require a {label}: line in the body",
            file=sys.stderr,
        )
        if hint:
            print(f"commit-msg: fix-hint: {hint}", file=sys.stderr)
        sys.exit(1)

    # Presence was the whole check until now, which let the trailers decay
    # into decoration. Validate what they SAY.
    check_trailer_content(policy, ctype, raw)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PY
