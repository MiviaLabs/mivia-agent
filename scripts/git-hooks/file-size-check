#!/usr/bin/env python3
"""Block files that exceed the maximum allowed size (500 KiB).

Modes:
  (default)  staged files only - pre-commit
  --tracked  all git-tracked files - pre-push / make structure-check
  --dir DIR  every file under DIR, no git - a git-archive-extracted staged
             tree (no .git present) already contains only what would be
             committed, so a plain walk is equivalent to --staged there

Skips vendor/, .git/, node_modules/, go.sum, and binary database files
(*.db, *.sqlite, *.sqlite3): databases are single opaque blobs that cannot
be split, so the size gate never applies to them.
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

MAX_BYTES = 500 * 1024  # 500 KiB
SKIP_PREFIXES = ("vendor/", ".git/", "node_modules/", "go.sum")
SKIP_SUFFIXES = (".db", ".sqlite", ".sqlite3")


def get_staged_files() -> list[str]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"file-size-check: git diff failed: {result.stderr}", file=sys.stderr)
        sys.exit(2)
    return [f for f in result.stdout.strip("\0").split("\0") if f]


def get_tracked_files() -> list[str]:
    result = subprocess.run(
        ["git", "ls-files", "-z"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"file-size-check: git ls-files failed: {result.stderr}", file=sys.stderr)
        sys.exit(2)
    return [f for f in result.stdout.strip("\0").split("\0") if f]


def get_dir_files(base: Path) -> list[str]:
    return [
        str(p.relative_to(base).as_posix())
        for p in base.rglob("*")
        if p.is_file() and not p.is_symlink()
    ]


def check_file_sizes(files: list[str], base: str) -> int:
    failures = 0
    for f in files:
        skip = False
        for prefix in SKIP_PREFIXES:
            if f.startswith(prefix) or f == prefix.rstrip("/"):
                skip = True
                break
        if skip:
            continue

        path = os.path.join(base, f)
        if path.endswith(SKIP_SUFFIXES):
            continue
        try:
            size = os.path.getsize(path)
        except OSError:
            continue

        if size > MAX_BYTES:
            size_kb = size / 1024
            print(
                f"file-size-check: BLOCKED: {f} is {size_kb:.0f} KiB "
                f"(max {MAX_BYTES // 1024} KiB)",
                file=sys.stderr,
            )
            failures += 1
    return failures


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument(
        "--tracked",
        action="store_true",
        help="Check all git-tracked files (pre-push / verify)",
    )
    mode.add_argument(
        "--dir",
        help="Check every file under DIR, no git required",
    )
    args = ap.parse_args()
    if args.dir:
        base = Path(args.dir).resolve()
        files = get_dir_files(base)
    else:
        base = Path.cwd()
        files = get_tracked_files() if args.tracked else get_staged_files()
    if not files:
        return 0

    failures = check_file_sizes(files, str(base))
    if failures:
        print(
            f"\nfile-size-check: {failures} file(s) exceed {MAX_BYTES // 1024} KiB limit. "
            "Split into smaller files or use .gitignore.\n",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
