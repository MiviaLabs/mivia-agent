# Binaries
/mivia
*.exe
*.test
*.out
coverage.out
coverage.html

# Go
vendor/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Agent runtime (local only)
.git/mivia-precommit-summary

# mivia workspace namespace: ignore only the machine-generated subtrees.
# Everything else under .mivia/ is tracked deliberately — instructions, rules,
# skills, plans and policy are reviewable configuration, and a blanket .mivia/
# ignore would hide them.
.mivia/sessions/
.mivia/worktrees/
.mivia/runs/
.mivia/handoffs/

# Claude worktrees (auto-generated by agent)
.claude/worktrees/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
secrets/*
!secrets/*.example

# Machine-specific config
mivia.toml

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Build / dist
dist/
bin/
