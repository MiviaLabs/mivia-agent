# Binaries
/mivia
/mivia-ui-demo
*.exe
*.test
*.out
coverage.out
coverage.html

# Go
vendor/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Agent runtime (local only)
.git/mivia-precommit-summary

# mivia workspace namespace: ignore only the machine-generated subtrees.
# Everything else under .mivia/ is tracked deliberately - instructions, rules,
# skills, plans and policy are reviewable configuration, and a blanket .mivia/
# ignore would hide them.
.mivia/sessions/
.mivia/runs/
.mivia/handoffs/
.mivia/context.db
.mivia/context.db-*
# Project memory database: the main file is COMMITTED in this repo (memories
# travel with the repository). Only the transient WAL/SHM sidecars are
# machine-local. Other repos may ignore the whole database instead.
.mivia/memory.db-wal
**/.mivia/memory.db-wal
**/.mivia/memory.db-shm
**/.mivia/memory.db
.mivia/memory.db-shm
# memory.jsonl was a pre-commit-maintained reviewable export of memory.db;
# the hook step that generated and staged it was removed (the export went
# stale the moment anyone forgot to run `mivia memory dump` by hand). Run
# that command manually if a one-off export is needed; it is not tracked.
.mivia/memory.jsonl
.mivia/.mivia-workflow-locks/

# Managed worktrees (auto-generated by agent)
.mivia/worktrees/
.mivia/worktrees.lock

# External tool worktrees (Claude Code, etc.)
.claude/worktrees/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
secrets/*
!secrets/*.example

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Build / dist
dist/
bin/

# Codegraph daemon state
codegraph.db*
.codegraph/
.mivia/run-logs/

# zcode session scratch state
.zcode/
