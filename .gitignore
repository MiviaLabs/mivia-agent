# Binaries
/mivia
*.exe
*.test
*.out
coverage.out
coverage.html

# Go
vendor/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Agent runtime (local only)
.git/mivia-precommit-summary

# mivia workspace namespace: ignore only the machine-generated subtrees.
# Everything else under .mivia/ is tracked deliberately - instructions, rules,
# skills, plans and policy are reviewable configuration, and a blanket .mivia/
# ignore would hide them.
.mivia/sessions/
.mivia/runs/
.mivia/handoffs/
.mivia/context.db
.mivia/context.db-*
.mivia/.mivia-workflow-locks/

# Managed worktrees (auto-generated by agent)
.mivia/worktrees/
.mivia/worktrees.lock

# External tool worktrees (Claude Code, etc.)
.claude/worktrees/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
secrets/*
!secrets/*.example

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Build / dist
dist/
bin/
