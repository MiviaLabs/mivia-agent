# Binaries
/mivia
*.exe
*.test
*.out
coverage.out
coverage.html

# Go
vendor/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Agent runtime (local only)
.ai/runs/
.ai/handoffs/
.git/mivia-precommit-summary

# mivia workspace namespace: ignore only the machine-generated subtrees.
# Committed config (agent-prompt.md, skills/, agents/) is tracked deliberately —
# it is workspace configuration, and a blanket .mivia/ ignore would hide it.
.mivia/sessions/
.mivia/worktrees/

# Claude worktrees (auto-generated by agent)
.claude/worktrees/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
secrets/*
!secrets/*.example

# Machine-specific config
mivia.toml

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Build / dist
dist/
bin/
