{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "files_changed", "inspected", "addressed_findings"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "addressed_findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inspected": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
