{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "files_changed", "inspected", "addressed_findings", "pr_title", "pr_summary"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "addressed_findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inspected": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "blocked_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "pr_title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "pr_summary": { "type": "string", "minLength": 1 },
    "deferred_files": {
      "type": "array",
      "description": "Diff-size repair only: workspace-relative paths of files whose edits are kept in the worktree but must NOT be part of THIS delivered diff (they made the diff exceed the stacking hard limit). The host commits these files separately and opens a follow-up PR for them automatically. Every path here must also appear in files_changed. Omit or leave empty when nothing was deferred.",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
