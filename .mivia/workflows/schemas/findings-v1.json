{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "finding_count", "no_findings", "has_perf", "inspected"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "severity", "title", "invariant", "evidence", "reachable_path", "impact", "remediation", "regression_test", "sweep"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "enum": ["perf", "logic"] },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "title": { "type": "string", "minLength": 1 },
          "invariant": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "reachable_path": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 },
          "regression_test": { "type": "string", "minLength": 1 },
          "sweep": { "type": "string", "minLength": 1 }
        }
      }
    },
    "finding_count": { "type": "integer", "minimum": 0, "maximum": 2 },
    "no_findings": { "type": "boolean" },
    "has_perf": { "type": "string", "enum": ["true", "false"] },
    "inspected": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
