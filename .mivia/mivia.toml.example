# mivia example config — copy to ./.mivia/mivia.toml or ~/.mivia/mivia.toml
# Secrets go in an env file or process environment — never here.
# Copy .env.example to ./.env for workspace credential configuration.

# Optional explicit env file for credentials:
# env_file = "./.env"

[provider]
# Default provider: deepseek. Default model: deepseek-v4-flash.
# Other providers: openrouter, zai.
name = "deepseek"
# "auto" (default) captures and publishes provider-reported prompt-cache
# usage accounting (cache hit/miss token counts) when a response reports it.
# "off" disables capture only - it cannot disable a provider's own automatic
# caching, which happens server-side with no request-side control.
# prompt_cache = "auto"

# ---------------------------------------------------------------------------
# Reasoning control (per model, never under [chat])
#
#   reasoning_efforts  the levels this model OFFERS, in picker order
#   reasoning          the DEFAULT, which must be one of them
#   reasoning_dialect  openai | openrouter | thinking | thinking_effort | thinking_preserved | none
#
# Levels: off | minimal | low | medium | high | xhigh | max
#
# Omit `reasoning_efforts` and the model has no reasoning surface: no field is
# sent, and `/effort` says so. Declaring efforts is what makes them selectable
# at runtime; `reasoning` picks which one is active from the start. Declaring
# efforts WITHOUT a default is fine - the model can reason but ships with it
# off until the user chooses. The dial is per model, so switching models
# switches it with the binding and discards any `/effort` override.
#
# Value sets differ by model and drift on every release, which is why they are
# yours to declare rather than compiled in: GPT-5.x accepts none..max, xAI
# grok-4.5 only low/medium/high and cannot disable, GLM-4.x is on/off while
# GLM-5.2+ adds graded depth. A level the model rejects returns a 400 naming
# the set it does accept.
#
# `reasoning_dialect` is the wire shape. zai (thinking object), openrouter and
# deepseek (thinking_effort) have vetted defaults; any other provider must name
# it, and mivia refuses to load a config that sets `reasoning` where no dialect
# can be resolved rather than silently sending nothing.
#
# The default is only enough when the model's own set fits it. The `thinking`
# dialect has exactly two wire outputs, on and off, so it can carry `off` plus
# ONE graded level. Offer two or more graded levels (say low + high) and every
# one of them would send an identical request, making `/effort` report changes
# the wire never got - mivia refuses that config and tells you to set
# `reasoning_dialect = "thinking_effort"`, which sends reasoning_effort
# alongside the thinking object.
#
# Sampling is never suppressed: `temperature` is sent exactly as configured
# whether or not reasoning is active.
# ---------------------------------------------------------------------------

[providers.deepseek]
# DeepSeek v4 thinking mode accepts reasoning_effort high/max (low/medium→high,
# xhigh→max). The client replays reasoning_content on tool-call turns
# (RequiresReasoningReplay). thinking_effort dialect emits the thinking object
# plus top-level reasoning_effort. Default high is a good agent balance.
models = [
  { name = "deepseek-v4-flash", context_window_tokens = 1000000, max_output_tokens = 384000, reasoning_efforts = ["high", "max"], reasoning = "high", reasoning_dialect = "thinking_effort" },
  { name = "deepseek-v4-pro", context_window_tokens = 1000000, max_output_tokens = 384000, reasoning_efforts = ["high", "max"], reasoning = "high", reasoning_dialect = "thinking_effort" },
]
default_model = "deepseek-v4-flash"
api_key_env = "DEEPSEEK_API_KEY"
base_url = "https://api.deepseek.com/v1"

[providers.ollama]
# Override CLI provider with --provider ollama
# Ollama Cloud profile (key required): https://ollama.com/v1 is also the
# built-in default, so base_url could be omitted entirely.
models = [
  { name = "gpt-oss:120b", context_window_tokens = 131072 },
]
default_model = "gpt-oss:120b"
api_key_env = "OLLAMA_API_KEY"
base_url = "https://ollama.com/v1"

# Local daemon profile (no key) - comment out the cloud keys above and
# uncomment this one instead. The mode is inferred from base_url alone:
# a loopback hostname (127.0.0.1, ::1, localhost) needs no API key, so
# api_key_env is optional; any other base_url requires OLLAMA_API_KEY.
# A local daemon has no remote catalog, so model names must match
# `ollama list` output exactly (tag included).
# models = [
#   { name = "gpt-oss:120b", context_window_tokens = 131072 },
# ]
# default_model = "gpt-oss:120b"
# base_url = "http://127.0.0.1:11434/v1"

[providers.openrouter]
# Override CLI provider with --provider openrouter
# OpenRouter normalizes reasoning_effort per upstream model, so it needs no
# reasoning_dialect either. Use reasoning_dialect = "openrouter" for the
# canonical nested reasoning object.
models = [
  { name = "openai/gpt-4o-mini", context_window_tokens = 128000 },
  # On/off reasoning only (no graded effort): "high" = thinking on. Tool
  # calling supported; no structured outputs (response_format unsupported).
  { name = "inclusionai/ling-3.0-flash", context_window_tokens = 262144, max_output_tokens = 32768, reasoning_efforts = ["off", "high"], reasoning = "high", reasoning_dialect = "openrouter" },
  # Poolside Laguna S 2.1: 118B-total / 8B-active MoE coding-agent model,
  # 1M context / 131K max completion, tool calling, reasoning off/max only
  # ("max" = thinking on; default on matches upstream). No response_format.
  # reasoning_dialect "openrouter_onoff" sends reasoning.enabled (the endpoint
  # reports supports_reasoning_effort:false); the client parses and replays
  # OpenRouter reasoning on tool loops. Benchmarks are vendor self-reports.
  # The :free variant trains on your inputs - use the paid endpoint (retains
  # prompts 90 days, trains nothing).
  { name = "poolside/laguna-s-2.1", context_window_tokens = 1048576, max_output_tokens = 131072, reasoning_efforts = ["off", "max"], reasoning = "max", reasoning_dialect = "openrouter_onoff" },
]
default_model = "openai/gpt-4o-mini"
api_key_env = "OPENROUTER_API_KEY"
base_url = "https://openrouter.ai/api/v1"

[providers.zai]
# Override CLI provider with --provider zai
# A key works on exactly one endpoint: pay-as-you-go keys use the URL below,
# GLM Coding Plan keys use https://api.z.ai/api/coding/paas/v4. Crossing them
# fails every request with code 1113 (no balance on that endpoint).
#
# GLM gates thinking with a thinking object (zai default dialect). thinking_preserved
# opts into Preserved Thinking (clear_thinking:false) per model and still carries
# reasoning_effort for graded depth. The factory default stays `thinking` so
# standard-PaaS users without the dialect are byte-identical. Note that z.ai
# ignores thinking:{"type":"disabled"} on some server paths, so reasoning = "off"
# is not guaranteed to take effect.
models = [
  { name = "glm-5.2", context_window_tokens = 200000, max_output_tokens = 16384, reasoning_efforts = ["low", "medium", "high", "max"], reasoning = "high", reasoning_dialect = "thinking_preserved" },
  # An entry with no reasoning keys offers nothing and sends no field:
  { name = "glm-4.6", context_window_tokens = 200000, max_output_tokens = 16384 },
]
default_model = "glm-5.2"
api_key_env = "ZAI_API_KEY"
base_url = "https://api.z.ai/api/paas/v4"

[chat]
system_prompt = "You are mivia, a local CLI coding agent."
temperature = 0
max_tokens = 16384
# Recommended prompt-budget bound (tokens). When unset, the budget is the
# model window minus the output reserve. A bounded budget compacts history
# earlier (at 80% of the budget) and cuts token cost on long sessions.
# Larger values keep more history at higher cost - a recall-versus-price dial.
max_prompt_tokens = 200000
# max_steps = 0  # 0 = unlimited (default). Set positive to cap turns. /steps overrides per session.

[worktrees]
# Prefix for branches that mivia creates for linked worktrees.
# Use a valid Git branch prefix. The default is "mivia/".
branch_prefix = "mivia/"

# ---------------------------------------------------------------------------
# Tool execution policies
# ---------------------------------------------------------------------------
# ---- Interactive turn ceiling ----
# max_steps bounds one turn's agent loop. Unset uses the built-in default (100).
# 0 means UNLIMITED: a model stuck emitting tool calls runs until interrupted.
# /steps overrides per session.
# max_steps = 100

[tools]
# ---- run_command program allowlist ----
# Nothing is compiled into the binary: with this unset, run_command executes
# no program at all. The list below is a recommended multi-ecosystem default;
# trim it to what your project actually needs.
#
# run_allowlist_only is accepted as a synonym — with no built-in list there is
# nothing to "replace", so the two keys behave identically.
run_allowlist = [
  "git", "make", "cmake", "ninja", "sh", "bash", "go", "gofmt",
  "govulncheck", "python", "python3", "pip", "pip3", "pytest", "uv", "nox",
  "node", "npm", "npx", "yarn", "pnpm", "bun", "deno", "tsx",
  "cargo", "rustc", "rustfmt", "clippy-driver", "ruby", "bundle", "gem", "rake",
  "rspec", "php", "composer", "phpunit", "java", "javac", "mvn", "gradle",
  "kotlin", "kotlinc", "dotnet", "dotnet-script", "swift", "swiftc", "zig", "zigcc",
  "elixir", "mix", "erl", "ghc", "cabal", "stack", "hlint", "perl",
  "cpan", "R", "lua", "luac", "awk", "sed", "grep", "egrep",
  "fgrep", "xargs", "tee", "envsubst", "tar", "gzip", "gunzip", "bzip2",
  "bunzip2", "xz", "unxz", "unzip", "zip", "zstd", "mkdir", "mkdirp",
  "rm", "cp", "mv", "touch", "ln", "chmod", "chown", "install",
  "mktemp", "realpath", "readlink", "basename", "dirname", "rg", "ag", "fd",
  "fzf", "bat", "delta", "echo", "ls", "cat", "tac", "nl",
  "od", "xxd", "hexdump", "pwd", "true", "false", "yes", "seq",
  "printf", "head", "tail", "sort", "uniq", "wc", "cut", "tr",
  "fold", "fmt", "diff", "patch", "comm", "cmp", "sdiff", "join",
  "paste", "expand", "unexpand", "strings", "iconv", "base64", "uuencode", "uudecode",
  "timeout", "nice", "nohup", "stdbuf", "parallel", "curl", "wget", "ssh",
  "scp", "docker", "kubectl", "helm", "terraform", "tofu", "vagrant", "env",
  "which", "id", "whoami", "date", "hostname", "uname", "arch", "nproc",
  "jq", "yq", "tomlq", "strace", "ltrace", "perf", "tracepath", "traceroute",
  "gdb", "lldb", "dlv", "ps", "top", "htop", "free", "df",
  "du", "lsof", "dmesg", "sysctl", "uptime", "sqlite3", "psql", "mysql",
  "redis-cli", "nano", "vim", "vi", "less", "more", "most", "convert",
  "identify", "magick", "ffmpeg", "ffprobe", "sox", "gh", "nix", "nix-shell",
  "nix-build", "nix-env",
]

# Block programs from the resolved allowlist (takes precedence).
# run_blocklist = ["rm", "sudo"]

# ---- Project diagnostics commands (get_diagnostics tool) ----
# Optional: a map of command name -> argv of the workspace-declared
# lint/type-check commands that the get_diagnostics tool runs, e.g.
#   { vet = ["go", "vet", "./..."], lint = ["npm", "run", "lint"] }
# A multi-ecosystem project can declare one entry per ecosystem/language.
# The model selects an entry with the "command" argument; omitting it runs the
# reserved "default" entry when one is configured, else the sole entry when
# exactly one is declared (with several entries and no "default", the model
# must name one). Unset (or an empty map) leaves the tool unregistered.
# Every entry is validated AT LOAD: the argv must be non-empty and argv[0]
# MUST be a bare program name on the effective run allowlist above
# (run_allowlist_only when set, else run_allowlist, minus run_blocklist) - a
# path-shaped, non-allowlisted, or blocklisted argv[0] is a load error, and
# the tool is never advertised unless its default command could actually run.
# Commands run under the same program allowlist and process guards as
# run_command - get_diagnostics adds no execution authority beyond run_command.
#
# V1's single-command key diagnostics_command is DEPRECATED: when set alone it
# folds into the map's reserved "default" entry. Setting BOTH
# diagnostics_command and diagnostics_commands is a load error - the map is
# the one surface, so remove the deprecated alias.
# diagnostics_commands = {
#   vet  = ["go", "vet", "./..."],
#   lint = ["npm", "run", "lint"],
# }

# ---- Environment variables passed to child processes ----
# Also configuration-only: with this unset, child processes inherit nothing.
# A trailing "*" declares a prefix rule (e.g. "GIT_*" matches GIT_DIR).
# Names containing SECRET/TOKEN/PASSWORD/API_KEY are dropped from prefix
# matches regardless — add them by exact name if a build genuinely needs one.
env_allowlist = [
  "PATH", "HOME", "USER", "USERNAME", "LOGNAME", "TMPDIR",
  "TMP", "TEMP", "SHELL", "TERM", "PWD", "OLDPWD",
  "HOSTNAME", "HOST", "LANG", "LANGUAGE", "EDITOR", "VISUAL",
  "MAKE", "MAKEFLAGS", "MAKELEVEL", "MFLAGS", "DISPLAY", "WAYLAND_DISPLAY",
  "XAUTHORITY", "SSH_AUTH_SOCK", "SSH_AGENT_PID", "GIT_PAGER", "GIT_EDITOR", "GIT_SEQUENCE_EDITOR",
  "GIT_CONFIG_SYSTEM", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM", "NPM_CONFIG_USERCONFIG", "CARGO_HOME", "RUSTUP_HOME",
  "GOPATH", "GOROOT", "KUBECONFIG", "CC", "CXX", "CGO_ENABLED",
  "CGO_CFLAGS", "CGO_LDFLAGS", "GOFLAGS", "GOPRIVATE", "GONOSUMCHECK", "GOSUMDB",
  "GOEXPERIMENT", "RUST_BACKTRACE", "RUST_LOG", "PIP_INDEX_URL", "PIP_EXTRA_INDEX_URL", "NODE_PATH",
  "CMAKE_GENERATOR", "MAKEOBJDIRPREFIX", "LC_*", "XDG_*", "GIT_*", "NODE_*",
]

# Subtractive filter for prefix matches: a variable admitted by a "*" rule is
# dropped if its name contains any of these. Exact entries above are never
# dropped, so a build that genuinely needs FOO_TOKEN names it outright.
# Nothing is compiled in — unset means prefix rules admit everything they match.
env_allow_keyword_blocklist = ["SECRET", "TOKEN", "PASSWORD", "API_KEY"]

# Block vars from the resolved allowlist.
# env_blocklist = ["GITHUB_TOKEN", "NPM_TOKEN"]

# ---- Write-path blocklist (workflow agent steps) ----
# Workflow agent write tools (write_file, search_replace, multi_edit,
# delete_file) refuse these workspace-relative paths or directories. Two paths
# are blocked by default and cannot be removed unless you explicitly opt out:
# .git and .mivia/mivia.toml. This key ADDS to that default set;
# write_path_blocklist_remove REMOVES entries from it (the defaults or an
# addition).
#
# Recommended starting values: the set below keeps workflow agents away from
# agent definitions, hook-policy gates, rules, skills, the workflow definition
# they run under, and Go module metadata. A project that omits this key leaves
# all of these writable by workflow agents, including its own workflow
# definition - choose deliberately.
#
# Removing a default entry is a trust decision. .mivia/mivia.toml carries this
# very blocklist: an agent that can edit it can remove its own restrictions,
# including the entries below. .git carries commit history and hooks: an agent
# that can edit it can rewrite history or plant hooks that bypass the host
# hook-policy gates. Keep both blocked unless a host-owned step genuinely
# needs the path. An entry in BOTH keys is a load error.
write_path_blocklist = [
    ".mivia/agents",    # agent definitions
    ".mivia/policy",    # hook-policy gates
    ".mivia/rules",     # durable rules
    ".mivia/skills",    # skill definitions
    ".mivia/workflows", # workflow definitions and templates
    "go.mod",
    "go.sum",
    "go.work",
]
# write_path_blocklist_remove = [".git", ".mivia/mivia.toml"]  # opt-out example

# Timeouts (seconds).
run_timeout_seconds = 900
# max_read_bytes = 262144       # uncomment to cap read_file at 256 KiB (default: uncapped)
# max_write_kb = 500            # uncomment to cap write_file at 500 KiB (default: uncapped)
# max_output_bytes = 200000     # uncomment to cap run_command at 200 KiB (default: uncapped)
#                             # under a positive bound, capture keeps ~1/3 head + 2/3 tail
# max_list_dir_entries = 500    # uncomment to cap list_dir entries (default: uncapped)
# max_grep_matches = 50         # uncomment to cap grep match count (default: uncapped)
# max_glob_matches = 200        # uncomment to cap glob match count (default: uncapped)

# OOM guard (MiB) for uncapped volume tools that may load whole files.
# Default 256. Not a context-cost cap. 0 resolves to 256 (cannot disable by accident).
# memory_backstop_mb = 256

# Bound on the body read by fetch_url, in KiB.
# Default 4096 (4 MiB). 0 = unlimited. Unlimited is safe here (unlike
# max_tavily_response_bytes): fetch_url truncates an over-bound body instead
# of refusing it, so an unbounded read still yields a bounded, usable result.
# Pages are often larger than the old 1024 KiB default, so raise it (or set 0)
# if you hit truncation.
# max_fetch_kb = 4096

# Deferred tool loading: the always-advertised "core" tool tier.
# Unset keeps every authorized tool core, which is byte-identical to a build
# without this feature - no load_tools tool, no prompt index, no behavior
# change. When set, tools the agent is authorized for but that are NOT named
# here are DEFERRED: their JSON schemas stop shipping on every request, and the
# model sees a one-line index of them plus a `load_tools` tool it can call to
# pull the ones it needs. Loaded tools become callable on the model's NEXT turn
# (the current turn's tool list was already sent), and they stay loaded for the
# rest of the agent binding.
# Naming a tool here never grants authority: the list is intersected with the
# selected agent's effective tool set. Per-agent override: tools_core in the
# agent TOML.
#
# HOW TO CHOOSE THE LIST. Core must contain every tool your system prompt tells
# the model to use as required process. Deferring one of those costs a wasted
# turn every session - the model is ordered to call a tool whose schema it
# cannot see, and only discovers `load_tools` from the index. This is not a
# style preference: it is the failure that got plan tools/07 rejected.
#
# Check BOTH prompt sources: the compiled default prompt, and system_prompt in
# any .mivia/agents/*.toml, which supersedes the default for the session it
# binds. Declaring a deferred tool in an agent's tools = [...] is fine - that
# bounds authority, not advertisement, and the model can still load it. Only
# prose instructions are the defect.
#
# This repo enforces the rule mechanically rather than by memory, in
# check_core_tier_covers_prompted_tools (scripts/verify_agent_config.py); copy
# that check if you fork this config, or re-derive the list whenever a prompt
# changes.
#
# Deferral cannot reach the delegation and run-history tools (delegate,
# dispatch_tasks, spawn_agent, inspect_agents, join_run, cancel_run,
# ledger_read, list_run_events, read_output). They are registered after the tier
# split is computed, so they always ship. On a default registry that is roughly
# half the tool-schema mass, and it bounds what this knob can save.
#
# Deferring a tool never narrows a delegated or routed agent's surface: sub-agent
# scope is derived from the session's authority registry, which does not carry
# the tier split (pinned by TestCoreTierDoesNotShrinkARoutedAgentsToolSurface).
#
# The saving is context-window occupancy. Billed cost is much smaller, because
# the tool block sits at the head of the prompt and caches well; loading a
# deferred tool invalidates the cached prefix once, at a turn boundary. Measure
# your own split rather than assuming - the numbers below predate moving the
# web tools to core; the remaining deferred set is the three code-navigation
# tools, so the saving is smaller than the measured 930 tok/request quoted here.
#   core kept   1737 tok (8 tools, before the web tools moved in)
#   deferred    1263 tok (5 tools: search, fetch_url, find_references,
#                         list_symbols, go_to_definition)
#   index        125 tok   load_tools 208 tok
#   NET SAVING   930 tok/request while none of the five are loaded
#
# The list below is the built-in file/shell set plus the web research tools
# (search, fetch_url, extract); it defers only the code-navigation tools
# (find_references, list_symbols, go_to_definition).
core = [
    "read_file",
    "list_dir",
    "grep",
    "glob",
    "inspect_repository",
    "write_file",
    "search_replace",
    "multi_edit",
    "run_command",
    "search",
    "fetch_url",
    "extract",
]

# Ceiling on each tool result stored in agent-loop history (bytes), applied
# identically to the interactive session and nested sub-agent loops.
# Default 0 = uncapped: the per-tool budgets above are the bound. Positive
# values below 1024 are rejected at load. Set 4000 to restore the pre-knob
# hardcoded ceiling (useful for small-context models).
# max_tool_result_bytes = 0

# Aggregate budget for ONE tool batch (bytes), across all of its parallel
# calls together - the bound max_tool_result_bytes cannot provide, because it
# sees each call in isolation. -1 (recommended) derives it from the model's
# prompt budget (a quarter of it, floor 256 KiB; inert without a prompt
# budget). 0 = off. Positive values are literal and must be >= 16384.
# Over-budget results are degraded to content references readable with
# read_output - never failed, and never destroyed.
batch_result_budget_bytes = -1

# Bound on a Tavily API response body, used by the `search` tool's Tavily path
# and by `extract`. Responses are NEVER truncated: this is not a cap on what
# reaches the model, it is the number that makes the maximum result size known.
# The tools enforce it on the response body and on every composed result (the
# free-engine fallback included), declare it as their result budget, and REFUSE
# an over-bound result with an explicit error naming this key. Each result's own
# content reaches the model whole — nothing is clipped.
# Unset or 0 uses the default below; there is no
# "unlimited" setting, because an undeclared result is what the backstop
# further down destroys. Valid range 1024 - 67108864.
# Only installs with a Tavily API key configured are affected: without one,
# neither tool can reach the provider and neither raises the backstop.
# max_tavily_response_bytes = 4194304

# Per-tool output ceiling (derived, not a knob): max(256 KiB, largest per-tool
# budget above + 64 KiB input allowance + 4 KiB framing slack). Honest oversize
# (ceiling < size ≤ ceiling×4) is tail-truncated with a kept/total notice;
# only runaway (size > ceiling×4) is destroyed as output budget exceeded.

# Redact run_command arguments from operator-visible output.
# redact_tool_args = false

# Secret path filter (file tools only). No patterns are compiled into the
# binary: with these unset, nothing is filtered. Matched case-insensitively as
# substrings of the workspace-relative path; exceptions win over patterns.
#
# This keeps credentials out of model context by accident. It is NOT a
# boundary: run_command reaches the same files through a shell.
secret_path_patterns = [
  ".env",       # dotenv files (also catches .env.local, .env.production)
  ".pem",       # private key certificates
  ".key",       # private keys
  "id_rsa",     # SSH private keys
  "id_ed25519", # SSH ed25519 keys
]
secret_path_exceptions = [
  ".env.example", # a template, not a real secret
]


# ---------------------------------------------------------------------------
# Third-party integrations
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Model Context Protocol (MCP) servers
# ---------------------------------------------------------------------------
# MCP configuration stores environment VARIABLE NAMES only. Do not put a token
# or a header value in this file. A project .mivia/mivia.toml may define MCP
# servers. A project server replaces a user server with the same id.
# [mcp]
# enabled = true
# startup_timeout_seconds = 10
# max_servers = 16
# max_tools_per_server = 64
# max_tool_schema_bytes = 65536
# max_tool_description_bytes = 4096
# max_tool_result_bytes = 65536
#
# [[mcp.servers]]
# id = "repository"
# transport = "stdio"
# command = "/usr/local/bin/repository-mcp"
# args = ["serve"]
# env = ["REPOSITORY_MCP_TOKEN"]
# global = true
# timeout_seconds = 30
#
# [[mcp.servers]]
# id = "issues"
# transport = "streamable_http"
# url = "https://mcp.example.test/mcp"
# headers = [{ name = "Authorization", value_env = "ISSUES_MCP_TOKEN" }]
# global = false
# timeout_seconds = 30

[integrations.tavily]
# Set the API key via TAVILY_API_KEY env var or in the env_file above.
api_key_env = "TAVILY_API_KEY"
# disable = false

# ---------------------------------------------------------------------------
# Subagent orchestration
# ---------------------------------------------------------------------------
[subagents]
# All bounds default to 0 (unlimited). Set positive values to cap.
max_workers = 0   # 0 = unlimited (one goroutine per task)
max_depth = -1    # -1 = unbounded DAG depth (0 also means unlimited)
max_fanout = -1   # -1 = unbounded task count (0 also means unlimited)
nested_steps = 0  # 0 = unlimited sub-agent loop steps
# default_timeout_seconds is the per-agent default budget. 43200s = 12 hours,
# the same safety bound an unset-or-0 value selects; it is written out so the
# default is visible and a smaller value never slips in silently. Batches and
# tasks may still raise it per call; they never lower it below this floor.
default_timeout_seconds = 43200
# default_request_timeout_seconds = 0  # per-LLM-request timeout (seconds); 0 = fall back to the effective orchestration default (default_timeout_seconds when positive, otherwise the 12-hour safety bound); internal 15-minute HTTP transport timeout is the hard per-request ceiling regardless
# default_budget = 0           # 0 = unlimited
# max_audit_rounds = 0         # 0 = unlimited

# [subagents.retry] controls whole-task retry for a dispatched task that
# failed with a transient error (network blip, 429, 5xx, timeout) or timed
# out. Disabled by default (max_retries = 0): a deployment must opt in.
# Distinct from schema_retry_max above, which governs corrective re-entries
# after an invalid schema-validated reply within one task, not whole-task
# retry.
#
# NOT safe for a task with side effects it can't undo: retry re-dispatches
# the whole task from scratch, it does not skip tool calls the failed attempt
# already made. A task that writes a file, calls an external API, or sends a
# message and only THEN hits a late transient error will repeat those side
# effects on retry. max_retries is capped at 20 and base_backoff_seconds is
# floored at 50ms regardless of the value set here, to bound retry-storm risk
# against a misconfiguration.
# [subagents.retry]
# max_retries = 0            # 0 = disabled (default); positive = attempts beyond the first, capped at 20
# base_backoff_seconds = 1   # initial backoff before the first retry; floored at 0.05 (50ms) if positive
# max_backoff_seconds = 30   # cap on backoff growth
# backoff_factor = 2.0       # exponential multiplier per attempt; 0 selects 2.0
# jitter_fraction = 0.25     # ±jitter_fraction/2 randomization; 0 disables jitter

# ---------------------------------------------------------------------------
# Durable context storage (byte fields under [context])
# ---------------------------------------------------------------------------
# max_source_event_bytes is payload CHUNK size (not whole-payload reject).
# 0 → built-in default chunk size (64 KiB). Large tool results store as
# ordered chunks under one content ref; reassembly is byte-identical.
# [context]
# max_source_event_bytes = 0
# max_checkpoint_bytes = 0
# max_commit_events = 0
# max_commit_event_bytes = 0
# max_session_state_bytes = 0
# max_export_bytes = 0
# LLM compaction summary: OFF by default. Also requires a configured
# [privacy] redaction policy and a resolved provider endpoint; otherwise
# it stays off. On compaction, mivia asks the session model to summarize
# what was dropped and injects the validated summary into the next request.
# Any summary failure degrades silently to structural-only compaction.
# [context.summary]
# enabled = false

# Storage backend: memory (ephemeral) or sqlite (durable)
store_backend = "sqlite"
# store_path = ""

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
[privacy]
# redact_tool_args hides run_command argv wholesale. Separate from the
# patterns below, which redact by content wherever it appears.
redact_tool_args = false

# Redaction is configuration-only: nothing is compiled into the binary, so
# WITH THESE UNSET NOTHING IS REDACTED ANYWHERE -- tool previews, run_command
# output (which the model reads), event bodies and audit metadata all pass
# through intact, including into the session transcript on disk.
#
# Each match is replaced by redaction_placeholder. An invalid pattern is a
# startup error, never a silently dropped rule.
redaction_patterns = [
  # Quotes are optional around key and value so this also matches JSON tool
  # argv ("token":"…"), which reaches the default preview as raw text.
  # The (?:bearer\s+)? is load-bearing: without it this pattern consumes
  # "Authorization: Bearer" and stops, leaving the credential for a later
  # pattern that no longer matches. With it, order does not matter.
  '(?i)"?(?:password|passwd|token|secret|api[_-]?key|authorization)"?\s*[:=]\s*"?(?:bearer\s+)?[^"\s,;}]+',
  '(?i)bearer\s+[A-Za-z0-9._~+/=-]+',
  '(?:sk-ant-|sk-|ghp_|github_pat_|xox[baprs]-)[A-Za-z0-9._~-]+',
  '(?is)-----BEGIN [A-Z0-9 ]+PRIVATE KEY-----.*?(?:-----END [A-Z0-9 ]+PRIVATE KEY-----|$)',
]

# JSON object keys whose values are elided wholesale (case-insensitive
# substring). Deliberately absent: "prompt" and "reasoning" -- they are the
# agent's own instructions and deliberation, not your secrets, and eliding
# them makes audit metadata useless while protecting nothing.
redaction_key_names = ["password", "token", "secret", "api_key", "authorization"]

redaction_placeholder = "[redacted]"

# ---------------------------------------------------------------------------
# Harness
# ---------------------------------------------------------------------------
[harness]
# Every workflow verifier/evidence-gate command (go build/test/vet, or a
# project's own preflight check) normally runs inside a bubblewrap (bwrap)
# sandbox: an isolated filesystem and network namespace, so a command a
# workflow or repair agent runs cannot touch the real host filesystem,
# network, or credentials. This is a security boundary, not a convenience --
# see .mivia/rules/10-security-privacy.md before turning it off.
#
# bwrap requires unprivileged user namespaces, which some hosts do not have
# enabled (kernel/AppArmor restrictions, or bwrap not installed). Setting
# this to false is the explicit escape hatch for that host: verifier
# commands then run directly, with none of the isolation above. Omit this
# key, or leave it true, everywhere else, including CI.
# sandbox = true

# ---------------------------------------------------------------------------
# AGENTS — definitions live under .mivia/agents/ (not inline here)
# ---------------------------------------------------------------------------
# Workspace agent files always load from <ws>/.mivia/agents/*.toml, even when
# the workspace gate is off. Default root agent name is "mivia" when that file
# exists (no --agent needed); otherwise the private compiled fallback is used.
#
# Example files:
#   .mivia/agents/mivia.toml          # root orchestrator (auto-selected)
#   .mivia/agents/go-engineer.toml    # implementation specialist (legacy name)
#   .mivia/agents/researcher.toml    # read-only evidence and web research
#   .mivia/agents/reviewer.toml      # read-only engineering review
#   .mivia/agents/security.toml      # read-only security/privacy review
#   .mivia/agents/docs.toml          # owned documentation edits
#   .mivia/agents/verifier.toml      # project-native checks without writes
#
# Filename is the canonical name; in-file name must match.
#
# Optional skills allowlist (plan 06 / INV-AG-30):
#   skills = ["bug-audit", "verify-change"]
#   omit = all trusted skills; skills = [] = none.
# Enforced when a task invokes a skill via its explicit agent + skill fields
# (and on resume/retry). The gate defaults on and controls workspace prompts
# and project skills, not agent-file discovery. Set the user-owned
# load_workspace_config = false to opt out of those workspace prompt/skill
# surfaces.
#
# USER-only (~/.mivia/mivia.toml) — workspace values for this key are ignored:
#   [agents]
#   load_workspace_config = false  # opt out of workspace skills + workspace
#                                  # [chat]/[subagents] system_prompt; NOT agent files

# ---------------------------------------------------------------------------
# LIFECYCLE HOOKS - user (~/.mivia/mivia.toml) AND project (<repo>/.mivia/mivia.toml)
# ---------------------------------------------------------------------------
# Scripts the RUNTIME runs at lifecycle events, deterministically. Not Git hooks
# (docs/development/hooks.md) and not skill triggers. See:
#   docs/development/lifecycle-hooks.md
#
# Both files supply hooks and they ADD rather than replace - hooks are the one
# setting mivia merges across layers. A project's formatter and your global gate
# are two hooks, not competing answers, and letting the workspace file replace
# yours would silently disarm a gate by opening a repository. USER hooks are
# ordered first, so a gate you wrote answers before a repository's does:
# PreToolUse stops at the first deny.
#
# THERE IS NO CONFIRMATION STEP. Declaring a hook arms it - interactively and
# headless alike. For your own file that is simply not re-asking a question you
# answered by saving it. For a project file it means a repository you cloned can
# run its scripts on your machine the first time you start mivia in it: read a
# project's .mivia/mivia.toml the way you would read its Makefile. mivia
# discloses rather than prompts - startup names every armed hook and says when
# one came with the repo, /hooks marks each [user] or [project], and every
# execution gets a transcript row.
#
# Arming a hook names a PROGRAM. mivia runs the file at argv[0] as it is on disk
# at call time and does not track its contents, so editing the script body
# changes what runs with no further step.
#
#   [[hooks]]
#   event   = "PreToolUse"        # PreToolUse | PostToolUse | Stop
#   matcher = "^run_command$"     # regex on tool name; absent or "" = every tool
#                                 # ANCHOR it: matching is unanchored, so
#                                 # "run_command" also selects run_command_v2
#
#     [[hooks.handlers]]
#     type       = "command"      # command only in v1
#     argv       = ["./hooks/bypass-guard.sh"]      # array, never a shell string
#     timeout    = 5              # seconds, 1-600
#     on_timeout = "block"        # block | allow - PreToolUse defaults to block,
#                                 # because a hung gate must not be an open gate
#
#   [[hooks]]
#   event   = "PostToolUse"
#   matcher = "^(write_file|search_replace)$"
#
#     [[hooks.handlers]]
#     type = "command"
#     argv = ["./hooks/format-changed.sh"]   # reads MIVIA_FILE from the environment
#
# This repository's own .mivia/mivia.toml declares both of those for real -
# see .mivia/hooks/ for two scripts written to be read before they are trusted.
#
# argv[0] resolves against THIS file's directory - so a user hook's "./hooks/x"
# is ~/.mivia/hooks/x and a project hook's is <repo>/.mivia/hooks/x. There is no
# PATH lookup and no shell, so `;`, `&&` and $(...) inside an element arrive as
# literal arguments. Context reaches the hook as MIVIA_* env vars and one JSON
# object on stdin, never spliced into the command line.
#
# Exit 0 allows (stdout becomes advisory context for the model, wrapped in a
# <lifecycle-hook-output> block it cannot forge). Exit 2 blocks, PreToolUse
# only, with stderr as the reason. Any other exit is a non-blocking warning.
#
# A faulty PROJECT config never fails startup: a symlink, an oversized file or
# one that does not parse is reported and contributes nothing, while your own
# hooks carry on. Your user config keeps the opposite treatment and fails closed.
#
# $MIVIA_CONFIG names the general config and supplies no hooks; a [[hooks]]
# table in it is reported and ignored.

# ---------------------------------------------------------------------------
# Workspace-declared verifier profiles for workflow evidence_gate steps.
# The mivia binary ships NO built-in profiles: a workflow step's
# `verifier = "checks"` resolves only against tables you declare here, so
# the engine works the same for any project or language. Each command runs
# in the verifier sandbox (copied worktree without secrets, no network, no
# host home, empty environment). `program` must be a bare executable name;
# `args` are argv passed verbatim, never a shell string. Set
# `go_module_baseline = true` on profiles that build or test a Go module:
# admission then pins go.mod/go.sum so a workflow agent cannot change what
# the gate builds against. Declare whatever fits your project, for example:
#
# [verifiers.checks]
# commands = [
#   { check = "unit-tests", program = "npm", args = ["test"] },
#   { check = "lint", program = "npx", args = ["eslint", "."] },
# ]
