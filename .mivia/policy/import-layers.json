  "deny": [
    {
      "from": "internal/chatsync",
      "to": "internal/chat",
      "reason": "settled decision 7: chatsync is a leaf. internal/chat pulls in ~47 internal packages (config, agent, contextstate, workspace, ...). The only use was chat.TurnErrorMessage; it is injected as ProjectorOptions.ErrorMessage instead."
    },
    {
      "from": "internal/chatsync",
      "to": "internal/tools",
      "reason": "settled decision 7: chatsync is a leaf. tools.RedactToolArgs() is process-global mutable state (an atomic.Bool), so reading it here makes any test of gate composition mutate a package global. The host passes the decision as ProjectorOptions.RedactToolArgs instead."
    },
    {
      "from": "internal/storage",
      "to": "internal/context/manager",
      "reason": "persistence package importing a domain policy package; the shared usage types moved to internal/usage (see internal/storage -> internal/usage)"
    },
    {
      "from": "internal/workflows/ledger",
      "to": "internal/coordinator",
      "reason": "persistence package importing the subagent runtime; the panel child-admission code lives in internal/workflows/panel"
    },
    {
      "from": "internal/workflows/ledger",
      "to": "internal/subagents",
      "reason": "persistence package importing the subagent runtime; the panel fingerprint validation lives in internal/workflows/panel"
    }
  ],
  "description": "Internal import edges: an allowed-edge baseline, an edge cap, and a deny-list that overrides the baseline. scripts/check_import_layers.py enforces this file."
