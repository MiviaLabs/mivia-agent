# mivia example config — copy to ./mivia.toml or ~/.config/mivia/config.toml
# Secrets go in an env file or process environment — never here.
# Copy .env.example to .env for credential configuration.

[provider]
# Supported: deepseek (default), openrouter
name = "deepseek"

# Optional explicit env file for credentials:
# env_file = "~/.config/mivia/.env"

[providers.deepseek]
model = "deepseek-v4-flash"
api_key_env = "DEEPSEEK_API_KEY"
base_url = "https://api.deepseek.com/v1"

[providers.openrouter]
# Override CLI provider with --provider openrouter
model = "openai/gpt-4o-mini"
api_key_env = "OPENROUTER_API_KEY"
base_url = "https://openrouter.ai/api/v1"
http_referer = "https://github.com/MiviaLabs/mivia-agent"
x_title = "mivia"

[chat]
system_prompt = "You are mivia, a local CLI coding agent."
temperature = 0
max_tokens = 4096

# ---------------------------------------------------------------------------
# Tool execution policies
# ---------------------------------------------------------------------------
[tools]
# Program allowlist: extend built-in default (~160 tools).
# Union: built-in + this list.
# run_allowlist = ["docker", "kubectl"]

# Replace built-in default entirely (ignore DefaultAllowlist).
# run_allowlist_only = ["git", "make", "go", "sh"]

# Block programs from the resolved allowlist (takes precedence).
# run_blocklist = ["rm", "sudo"]

# Disable built-in tools entirely (by name).
# disable_tools = ["search", "fetch_url", "extract"]

# Timeouts (seconds).
run_timeout_seconds = 300
# max_read_bytes = 262144
# max_write_kb = 500
# max_output_bytes = 200000
# max_list_dir_entries = 500

# Redact run_command arguments from operator-visible output.
# redact_tool_args = false

# Environment variable allowlist: extend built-in default (~40 vars).
# env_allowlist = ["MY_PROJECT_VAR"]
# Replace built-in default entirely.
# env_allowlist_only = ["PATH", "HOME", "USER"]
# Block vars from the resolved allowlist.
# env_blocklist = ["GITHUB_TOKEN", "NPM_TOKEN"]

# ---------------------------------------------------------------------------
# Third-party integrations
# ---------------------------------------------------------------------------
[integrations.tavily]
# Set the API key via TAVILY_API_KEY env var or in the env_file above.
api_key_env = "TAVILY_API_KEY"
# disable = false

# ---------------------------------------------------------------------------
# Subagent orchestration
# ---------------------------------------------------------------------------
[subagents]
max_workers = 16
max_depth = 3
max_fanout = 200
# default_timeout_seconds = 60
# default_budget = 0
# partial_results = false
# max_audit_rounds = 5  # -1 = unlimited

# Storage backend: memory (ephemeral) or sqlite (durable)
store_backend = "sqlite"
# store_path = ""

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# [privacy]
# redact_tool_args = false
